msgstr "Carga hidráulica en el nodo"

#: gusnet/elements.py:761
msgid "Water pressure at node"
msgstr "Presión de agua en el nodo"

#: gusnet/elements.py:763
msgid "Water flow rate through link"
msgstr "Caudal de agua a través del enlace"

#: gusnet/elements.py:765
msgid "Head loss across link"
msgstr "Pérdida de carga a través del enlace"

#: gusnet/elements.py:767
msgid "Head loss proportional to length of pipe"
msgstr "Pérdida de carga proporcional a la longitud de la tubería"

#: gusnet/elements.py:769
msgid "Water velocity in link"
msgstr "Velocidad del agua en el enlace"

#: gusnet/elements.py:771
msgid "Water quality concentration"
msgstr "Concentración de calidad del agua"

#: gusnet/elements.py:773
msgid "Rate of water quality reaction"
msgstr "Tasa de reacción de la calidad del agua"

#: gusnet/epanet_wrapper.py:171
msgid ""
"System hydraulically unbalanced - convergence to a hydraulic solution was"
" not achieved in the allowed number of trials"
msgstr ""
"Sistema hidráulicamente desequilibrado: no se logró la convergencia a una"
" solución hidráulica en el número de iteraciones permitidas"

#: gusnet/epanet_wrapper.py:174
msgid ""
"System may be hydraulically unstable - hydraulic convergence was only "
"achieved after the status of all links was held fixed"
msgstr ""
"El sistema puede ser hidráulicamente inestable: la convergencia "
"hidráulica solo se logró tras fijar el estado de todos los enlaces"

#: gusnet/epanet_wrapper.py:176
msgid ""
"System disconnected - one or more nodes with positive demands were "
"disconnected for all supply sources"
msgstr ""
"Sistema desconectado: uno o más nodos con demandas positivas quedaron "
"desconectados de todas las fuentes de suministro"

#: gusnet/epanet_wrapper.py:178
msgid ""
"Pumps cannot deliver enough flow or head - one or more pumps were forced "
"to either shut down (due to insufficient head) or operate beyond the "
"maximum rated flow"
msgstr ""
"Las bombas no pueden suministrar suficiente caudal o altura: una o más "
"bombas se vieron obligadas a apagarse (por altura insuficiente) o a "
"operar más allá del caudal máximo nominal"

#: gusnet/epanet_wrapper.py:181
msgid ""
"Valves cannot deliver enough flow - one or more flow control valves could"
" not deliver the required flow even when fully open"
msgstr ""
"Las válvulas no pueden suministrar suficiente caudal: una o más válvulas "
"de control no pudieron suministrar el caudal requerido ni siquiera "
"estando completamente abiertas"

#: gusnet/epanet_wrapper.py:184
msgid ""
"System has negative pressures - negative pressures occurred at one or "
"more junctions with positive demand"
msgstr ""
"El sistema tiene presiones negativas: se produjeron presiones negativas "
"en una o más uniones con demanda positiva"

#: gusnet/epanet_wrapper.py:187
msgid "insufficient memory available"
msgstr "memoria insuficiente disponible"

#: gusnet/epanet_wrapper.py:188
msgid "no network data available"
msgstr "no hay datos de red disponibles"

#: gusnet/epanet_wrapper.py:189
msgid "hydraulics not initialized"
msgstr "hidráulica no inicializada"

#: gusnet/epanet_wrapper.py:190
msgid "no hydraulics for water quality analysis"
msgstr "sin hidráulica para el análisis de calidad del agua"

#: gusnet/epanet_wrapper.py:191
msgid "water quality not initialized"
msgstr "calidad del agua no inicializada"

#: gusnet/epanet_wrapper.py:192
msgid "no results saved to report on"
msgstr "no hay resultados guardados para reportar"

#: gusnet/epanet_wrapper.py:193
msgid "hydraulics supplied from external file"
msgstr "hidráulica suministrada desde archivo externo"

#: gusnet/epanet_wrapper.py:194
msgid "cannot use external file while hydraulics solver is active"
msgstr ""
"no se puede usar un archivo externo mientras el solucionador hidráulico "
"está activo"

#: gusnet/epanet_wrapper.py:195
msgid "cannot change time parameter when solver is active"
msgstr ""
"no se puede cambiar el parámetro de tiempo cuando el solucionador está "
"activo"

#: gusnet/epanet_wrapper.py:196
msgid "cannot solve network hydraulic equations"
msgstr "no se pueden resolver las ecuaciones hidráulicas de la red"

#: gusnet/epanet_wrapper.py:197
msgid "cannot solve water quality transport equations"
msgstr "no se pueden resolver las ecuaciones de transporte de calidad del agua"

#: gusnet/epanet_wrapper.py:199
msgid "one or more errors in input file"
msgstr "uno o más errores en el archivo de entrada"

#: gusnet/epanet_wrapper.py:200
msgid "syntax error"
msgstr "error de sintaxis"

#: gusnet/epanet_wrapper.py:201
