#: gusnet/elements.py:744
msgid "Tank mixing model type for water quality analysis"
msgstr "Tipo de modelo de mezcla de tanque para análisis de calidad del agua"

#: gusnet/elements.py:746
msgid "Bulk reaction rate coefficient for water quality analysis"
msgstr ""
"Coeficiente de velocidad de reacción global para análisis de calidad del "
"agua"

#: gusnet/elements.py:748
msgid "Wall reaction rate coefficient for water quality analysis"
msgstr ""
"Coeficiente de velocidad de reacción de pared para análisis de calidad "
"del agua"

#: gusnet/elements.py:750
msgid "Pump efficiency curve (flow vs efficiency) for energy use analysis"
msgstr ""
"Curva de eficiencia de la bomba (caudal vs eficiencia) para análisis "
"energético"

#: gusnet/elements.py:752
msgid "Time-varying pattern for energy price"
msgstr "Patrón variable en el tiempo para el precio de la energía"

#: gusnet/elements.py:754
msgid "Energy price per kW hour for energy use analysis"
msgstr "Precio de la energía por kWh para análisis energético"

#: gusnet/elements.py:757
msgid "Water demand at node"
msgstr "Demanda de agua en el nodo"

#: gusnet/elements.py:759
