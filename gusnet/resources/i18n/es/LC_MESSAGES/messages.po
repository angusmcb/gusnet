msgid "Writing EPANET input file"
msgstr "Escribiendo archivo de entrada de EPANET"

#: gusnet/gusnet_processing/run_simulation.py
msgid "Run EPANET simulation"
msgstr "Ejecutar simulacion EPANET"

#: gusnet/gusnet_processing/run_simulation.py
msgid "Process results output file"
msgstr "Procesar archivo de salida de resultados"

#: gusnet/gusnet_processing/run_simulation.py
msgid "Creating output layers"
msgstr "Creando capas de salida"

#: gusnet/gusnet_processing/run_simulation.py
msgid "Export to Epanet INP file"
msgstr "Exportar a archivo INP de Epanet"

#: gusnet/gusnet_processing/run_simulation.py
msgid ""
"This will take all of the model layers (junctions, tanks, reservoirs, "
"pipes, valves, pumps),combine them with the chosen options, and produce "
"an EPANET '.inp' file which can be run / viewed in other software."
msgstr ""
"Esto tomará todas las capas del modelo (uniones, tanques, depósitos, "
"tuberías, válvulas y bombas), las combinará con las opciones elegidas y "
"generará un archivo '.inp' de EPANET que podrá ejecutarse o visualizarse "
"en otro software."

#: gusnet/gusnet_processing/run_simulation.py
msgid "Output .inp file"
msgstr "Archivo de salida .inp"

