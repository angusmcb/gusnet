#: gusnet/elements.py
msgid ""
"Element identifier. If provided, it must be less than 32 characters and "
"not contain any spaces."
msgstr ""
"Identificador del elemento. Si se proporciona, debe tener menos de 32 "
"caracteres y no contener espacios."

#: gusnet/elements.py
msgid "Height above datum. This is in metres or feet."
msgstr "Altura sobre el datum. Está en metros o pies."

#: gusnet/elements.py
msgid "The demand for the element. Can be negative for inflows."
msgstr "La demanda para el elemento. Puede ser negativa para entradas."

#: gusnet/elements.py
msgid "Time-varying multiplier pattern for base demand"
msgstr "Patrón multiplicador variable en el tiempo para la demanda base"

#: gusnet/elements.py
msgid "Coefficient for flow through emitter at junction"
msgstr "Coeficiente para el flujo a través del emisor en la unión"

#: gusnet/elements.py
msgid "Initial water level in tank"
msgstr "Nivel inicial de agua en el tanque"

#: gusnet/elements.py
msgid "Minimum allowable water level in tank"
msgstr "Nivel mínimo permitido de agua en el tanque"

#: gusnet/elements.py
msgid "Maximum allowable water level in tank"
msgstr "Nivel máximo permitido de agua en el tanque"

#: gusnet/elements.py
msgid "Type of valve (PRV, PSV, PBV, FCV, TCV, GPV)"
msgstr "Tipo de válvula (PRV, PSV, PBV, FCV, TCV, GPV)"

#: gusnet/elements.py
msgid "Pressure setting for PRV, PBV, and PSV"
msgstr "Ajuste de presión para PRV, PBV y PSV"

#: gusnet/elements.py
msgid "Flow setting for FCV"
msgstr "Ajuste de caudal para FCV"

#: gusnet/elements.py
msgid "Throttle setting for TCV"
msgstr "Ajuste de estrangulamiento para TCV"

#: gusnet/elements.py
msgid "Internal diameter of pipe"
msgstr "Diámetro interno de la tubería"

#: gusnet/elements.py
msgid "Diameter of tank"
msgstr "Diámetro del tanque"

#: gusnet/elements.py
msgid "Minimum volume of water in tank"
msgstr "Volumen mínimo de agua en el tanque"

#: gusnet/elements.py
msgid "Volume curve relating tank level to volume"
msgstr "Curva de volumen que relaciona el nivel del tanque con el volumen"

#: gusnet/elements.py
msgid "Whether tank can overflow when full"
msgstr "Si el tanque puede desbordarse cuando está lleno"

#: gusnet/elements.py
msgid "Hydraulic head at reservoir"
msgstr "Carga hidráulica en el depósito"

#: gusnet/elements.py
msgid "Time-varying pattern for reservoir head"
msgstr "Patrón variable en el tiempo para la carga del depósito"

#: gusnet/elements.py
msgid ""
"Physical length of pipe. If left blank this will be calculated "
"automatically"
msgstr ""
"Longitud física de la tubería. Si se deja en blanco se calculará "
"automáticamente"

#: gusnet/elements.py
msgid "Pipe roughness coefficient for headloss calculation"
msgstr ""
"Coeficiente de rugosidad de la tubería para el cálculo de la pérdida de "
"carga"

#: gusnet/elements.py
msgid "Minor loss coefficient for fittings and bends"
msgstr "Coeficiente de pérdida menor para accesorios y codos"

#: gusnet/elements.py
msgid "Whether pipe has check valve to prevent backflow"
msgstr "Si la tubería tiene válvula de retención para evitar el reflujo"

#: gusnet/elements.py
msgid "How is pump described (by power or by head curve)"
msgstr "Cómo se describe la bomba (por potencia o por curva de altura)"

#: gusnet/elements.py
msgid "Flow vs head curve for pump"
msgstr "Curva caudal-altura para la bomba"

#: gusnet/elements.py
msgid "Power rating of pump"
msgstr "Potencia nominal de la bomba"

#: gusnet/elements.py
msgid "Base rotational speed of pump"
msgstr "Velocidad de rotación base de la bomba"

#: gusnet/elements.py
msgid "Time-varying pattern for pump speed"
msgstr "Patrón variable en el tiempo para la velocidad de la bomba"

#: gusnet/elements.py
msgid "Initial operating status"
msgstr "Estado operativo inicial"

#: gusnet/elements.py
msgid "Initial valve status (active, open, closed)"
msgstr "Estado inicial de la válvula (activo, abierto, cerrado)"

#: gusnet/elements.py
msgid "Head loss curve (flow vs head loss) for general purpose valve"
msgstr ""
"Curva de pérdida de carga (caudal vs pérdida de carga) para válvula de "
"propósito general"

#: gusnet/elements.py
msgid "Initial water quality concentration for water quality analysis"
msgstr "Concentración inicial de calidad del agua para análisis de calidad"

#: gusnet/elements.py
msgid "Fraction of tank volume for mixing model for two-compartment mixing model"
msgstr ""
"Fracción del volumen del tanque para el modelo de mezcla de dos "
"compartimentos"

#: gusnet/elements.py
msgid "Tank mixing model type for water quality analysis"
msgstr "Tipo de modelo de mezcla de tanque para análisis de calidad del agua"

#: gusnet/elements.py
msgid "Bulk reaction rate coefficient for water quality analysis"
msgstr ""
"Coeficiente de velocidad de reacción global para análisis de calidad del "
"agua"

#: gusnet/elements.py
msgid "Wall reaction rate coefficient for water quality analysis"
msgstr ""
"Coeficiente de velocidad de reacción de pared para análisis de calidad "
"del agua"

#: gusnet/elements.py
msgid "Pump efficiency curve (flow vs efficiency) for energy use analysis"
msgstr ""
"Curva de eficiencia de la bomba (caudal vs eficiencia) para análisis "
"energético"

#: gusnet/elements.py
msgid "Time-varying pattern for energy price"
msgstr "Patrón variable en el tiempo para el precio de la energía"

#: gusnet/elements.py
msgid "Energy price per kW hour for energy use analysis"
msgstr "Precio de la energía por kWh para análisis energético"

#: gusnet/elements.py
msgid "Water demand at node"
msgstr "Demanda de agua en el nodo"

#: gusnet/elements.py
msgid "Hydraulic head at node"
msgstr "Carga hidráulica en el nodo"

#: gusnet/elements.py
msgid "Water pressure at node"
msgstr "Presión de agua en el nodo"

#: gusnet/elements.py
msgid "Water flow rate through link"
msgstr "Caudal de agua a través del enlace"

#: gusnet/elements.py
msgid "Head loss across link"
msgstr "Pérdida de carga a través del enlace"

#: gusnet/elements.py
msgid "Head loss proportional to length of pipe"
msgstr "Pérdida de carga proporcional a la longitud de la tubería"

#: gusnet/elements.py
msgid "Water velocity in link"
msgstr "Velocidad del agua en el enlace"

#: gusnet/elements.py
msgid "Water quality concentration"
msgstr "Concentración de calidad del agua"

#: gusnet/elements.py
msgid "Rate of water quality reaction"
msgstr "Tasa de reacción de la calidad del agua"

#: gusnet/elements.py
msgid "Flow units for the model"
msgstr "Unidades de caudal para el modelo"

#: gusnet/elements.py
msgid ""
"Flow units will determine the units of other units used in the model as "
"well.Selecting a metric-based unit set means everything will be metric, "
"wheras selecting an imperial measure means everything will be imperial."
msgstr ""
"Las unidades de caudal determinarán también las unidades de las demás "
"magnitudes del modelo. Si se selecciona un sistema métrico, todo será "
"métrico; si se selecciona un sistema imperial, todo será imperial."

#: gusnet/elements.py
msgid "Formula to use for headloss calculations"
msgstr "Fórmula a usar para calcular las pérdidas de carga"

#: gusnet/elements.py
msgid "Duration of the simulation in hours (or 0 for single period)"
msgstr "Duración de la simulación en horas (o 0 para periodo único)"

#: gusnet/elements.py
msgid "Global multiplier for all demands in the model"
msgstr "Multiplicador global para todas las demandas del modelo"

#: gusnet/elements.py
msgid "Default pattern to use for any pattern fields left blank"
msgstr "Patrón predeterminado para los campos de patrón que queden en blanco"

#: gusnet/elements.py
msgid "Exponent for emitter calculations"
msgstr "Exponente para los cálculos de emisores"

#: gusnet/elements.py
msgid "Whether to model demands as fixed or pressure dependent"
msgstr "Si se modelan las demandas como fijas o dependientes de la presión"

#: gusnet/elements.py
msgid "Minimum pressure for pressure dependent demand calculations"
msgstr "Presión mínima para los cálculos de demanda dependiente de la presión"

#: gusnet/elements.py
msgid "Required pressure for pressure dependent demand calculations"
msgstr "Presión requerida para los cálculos de demanda dependiente de la presión"

#: gusnet/elements.py
msgid "Exponent for pressure dependent demand calculations"
msgstr "Exponente para los cálculos de demanda dependiente de la presión"

#: gusnet/elements.py
msgid "Price of energy per kW hour for energy calculations"
msgstr "Precio de la energía por kWh para análisis energético"

#: gusnet/elements.py
msgid "Pattern of price multiplier to use for energy calculations"
msgstr "Patrón del multiplicador de precio para los cálculos de energía"

#: gusnet/elements.py
msgid "Global efficiency of pumps for energy calculations - as a percentage"
msgstr ""
"Eficiencia global de las bombas para los cálculos de energía, como "
"porcentaje"

#: gusnet/elements.py
msgid "Demand charge for energy calculations"
msgstr "Cargo por demanda para los cálculos de energía"

#: gusnet/elements.py
msgid "Type of water quality analysis to do"
msgstr "Tipo de análisis de calidad del agua a realizar"

#: gusnet/elements.py
msgid "Mass unit to use for water quality analysis"
msgstr "Unidad de masa a usar para el análisis de calidad del agua"

#: gusnet/elements.py
msgid "Relative diffusivity for water quality analysis"
msgstr "Difusividad relativa para el análisis de calidad del agua"

#: gusnet/elements.py
msgid "Node to track for trace analysis (if quality parameter is TRACE)"
msgstr ""
"Nodo a seguir para el análisis de trazador (si el parámetro de calidad es"
" TRACE)"

#: gusnet/elements.py
msgid "Tolerance for water quality convergence in extended period simulations"
msgstr ""
"Tolerancia de convergencia de calidad del agua en simulaciones de período"
" extendido"

#: gusnet/elements.py
msgid "Order of the bulk reaction for water quality analysis"
msgstr "Orden de la reacción en masa para el análisis de calidad del agua"

#: gusnet/elements.py
msgid "Order of the wall reaction for water quality analysis"
msgstr "Orden de la reacción en la pared para el análisis de calidad del agua"

#: gusnet/elements.py
msgid "Global bulk coefficient for water quality analysis"
msgstr "Coeficiente global en masa para el análisis de calidad del agua"

#: gusnet/elements.py
msgid "Global wall coefficient for water quality analysis"
msgstr "Coeficiente global en la pared para el análisis de calidad del agua"

#: gusnet/elements.py
msgid ""
"Limiting concentration for water quality analysis (concentration below "
"which reactions are assumed to stop)"
msgstr ""
"Concentración límite para el análisis de calidad del agua (por debajo de "
"esta concentración se asume que las reacciones se detienen)"

#: gusnet/elements.py
msgid ""
"Correlation for calculating wall reaction coefficient based on pipe "
"diameter (if 0, wall coefficient will be constant)"
msgstr ""
"Correlación para calcular el coeficiente de reacción en pared según el "
"diámetro de la tubería (si es 0, el coeficiente de pared será constante)"

#: gusnet/epanet_wrapper.py
#, python-brace-format
msgid "EPANET returned warning code {error_code}: {warning_text}"
msgstr "EPANET devolvió el código de advertencia {error_code}: {warning_text}"

#: gusnet/epanet_wrapper.py
#, python-brace-format
msgid ""
"EPANET returned warning code {error_code} at simulation time {time}: "
"{warning_text}"
msgstr ""
"EPANET devolvió el código de advertencia {error_code} en el tiempo de "
"simulación {time}: {warning_text}"

#: gusnet/epanet_wrapper.py
msgid ""
"System hydraulically unbalanced - convergence to a hydraulic solution was"
" not achieved in the allowed number of trials"
msgstr ""
"Sistema hidráulicamente desequilibrado: no se logró la convergencia a una"
" solución hidráulica en el número de iteraciones permitidas"

#: gusnet/epanet_wrapper.py
msgid ""
"System may be hydraulically unstable - hydraulic convergence was only "
"achieved after the status of all links was held fixed"
msgstr ""
"El sistema puede ser hidráulicamente inestable: la convergencia "
"hidráulica solo se logró tras fijar el estado de todos los enlaces"

#: gusnet/epanet_wrapper.py
msgid ""
"System disconnected - one or more nodes with positive demands were "
"disconnected for all supply sources"
msgstr ""
"Sistema desconectado: uno o más nodos con demandas positivas quedaron "
"desconectados de todas las fuentes de suministro"

#: gusnet/epanet_wrapper.py
msgid ""
