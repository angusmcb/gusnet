#: gusnet/gusnet_processing/import_inp.py
msgid ""
"Import all junctions, tanks, reservoirs, pipes, pumps and valves from an "
"EPANET inp file. This will also save selected options from the .inp file."
" "
msgstr ""
"Importa todas las uniones, tanques, depósitos, tuberías, bombas y "
"válvulas desde un archivo INP de EPANET. Esto también guardará las "
"opciones seleccionadas del archivo .inp. Todas las unidades se "
"convertirán al juego de unidades seleccionado. Si no se selecciona "
"ninguno, se usará por defecto el juego de unidades del archivo .inp."

