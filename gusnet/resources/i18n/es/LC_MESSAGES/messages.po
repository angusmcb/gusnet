#: gusnet/api.py
#, python-brace-format
msgid "No units specified. Will use the value from wn: {units_friendly_name}"
msgstr ""
"No se especificaron unidades. Se usará el valor de wn: "
"{units_friendly_name}"

#: gusnet/api.py
msgid ""
"Cannot set headloss formula when wn is set. Set the headloss in the "
"wn.options.hydraulic.headloss instead"
msgstr ""
"No se puede establecer la formula de perdida de carga cuando wn esta "
"definido. Configure la perdida de carga en wn.options.hydraulic.headloss."

#: gusnet/api.py
msgid "headloss must be set if wn is not set: possible values are: H-W, D-W, C-M"
msgstr ""
"la pérdida de carga debe establecerse si wn no está configurado: los "
"valores posibles son: H-W, D-W, C-M"

#: gusnet/api.py
msgid "No valid CRS found on input layers. Pipe lengths will not be calculated."
msgstr ""
"No se encontro un CRS valido en las capas de entrada. No se calcularan "
"las longitudes de tuberias."

#: gusnet/api.py
msgid ""
"Some input layers do not have a valid CRS. Pipe lengths may not be "
"calculated correctly."
msgstr ""
"Algunas capas de entrada no tienen un CRS valido. Es posible que las "
"longitudes de tuberias no se calculen correctamente."

#: gusnet/api.py
msgid "Multiple different CRSs found on input layers."
msgstr "Se encontraron varios CRS diferentes en las capas de entrada."

#: gusnet/api.py
#, python-brace-format
msgid "CRS {crs} is not valid."
msgstr "El CRS {crs} no es válido."

#: gusnet/api.py
#, python-brace-format
msgid "{exception} is not a known set of units. Possible units are: "
msgstr "{exception} is not a known set of units. Possible units are:"

#: gusnet/api.py
#, python-brace-format
msgid ""
"{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS',"
" 'TANKS', 'PIPES', 'VALVES', 'PUMPS'."
msgstr ""
"{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS',"
" 'TANKS', 'PIPES', 'VALVES', 'PUMPS'."

#: gusnet/dependencies.py
msgid "Fetching EPANET"
msgstr "Descargando EPANET"

#: gusnet/dependencies.py
msgid "Took too long to fetch and install."
msgstr "Tardó demasiado en descargar e instalar."

#: gusnet/dependencies.py
msgid "Couldn't find Python"
msgstr "No se pudo encontrar Python"

#: gusnet/dependencies.py
#, python-brace-format
msgid "Couldn't fetch and install gusnet_epanet. {exception}"
msgstr "No se pudo descargar e instalar gusnet_epanet. {exception}"

#: gusnet/dependencies.py
#, python-brace-format
msgid ""
"Missing necessary python packages {missing_deps}. Please see help for how"
" to fix this"
msgstr ""
"Faltan los paquetes de Python necesarios {missing_deps}. Consulta la "
"ayuda para saber cómo solucionarlo"

#: gusnet/dependencies.py
msgid "Fetching gusnet_epanet is already in progress. Please wait and try again."
msgstr ""
"La descarga de gusnet_epanet ya esta en curso. Espere e intentelo de "
"nuevo."

