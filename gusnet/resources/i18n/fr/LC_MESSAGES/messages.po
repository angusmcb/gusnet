#, python-brace-format
msgid "EPANET returned warning code {error_code}: {warning_text}"
msgstr "EPANET a renvoyé le code d'avertissement {error_code} : {warning_text}"

#, python-brace-format
msgid "EPANET returned warning code {error_code} at simulation time {time}: {warning_text}"
msgstr "EPANET a renvoyé le code d'avertissement {error_code} au temps de simulation {time} : {warning_text}"

msgid "System hydraulically unbalanced - convergence to a hydraulic solution was not achieved in the allowed number of trials"
msgstr "Système hydrauliquement déséquilibré - la convergence vers une solution hydraulique n'a pas été atteinte dans le nombre d'essais autorisé"

msgid "System may be hydraulically unstable - hydraulic convergence was only achieved after the status of all links was held fixed"
msgstr "Le système peut être hydrauliquement instable - la convergence hydraulique n'a été atteinte qu'après avoir figé l'état de tous les liens"

msgid "System disconnected - one or more nodes with positive demands were disconnected for all supply sources"
msgstr "Système déconnecté - un ou plusieurs nœuds avec une demande positive étaient déconnectés de toutes les sources d'alimentation"

msgid "Pumps cannot deliver enough flow or head - one or more pumps were forced to either shut down (due to insufficient head) or operate beyond the maximum rated flow"
msgstr "Les pompes ne peuvent pas fournir un débit ou une hauteur suffisants - une ou plusieurs pompes ont été forcées soit à s'arrêter (hauteur insuffisante), soit à fonctionner au-delà du débit maximal nominal"

msgid "Valves cannot deliver enough flow - one or more flow control valves could not deliver the required flow even when fully open"
msgstr "Les vannes ne peuvent pas fournir un débit suffisant - une ou plusieurs vannes de régulation de débit n'ont pas pu fournir le débit requis, même entièrement ouvertes"

msgid "System has negative pressures - negative pressures occurred at one or more junctions with positive demand"
msgstr "Le système présente des pressions négatives - des pressions négatives sont apparues à une ou plusieurs jonctions avec une demande positive"

