#, python-brace-format
msgid "No units specified. Will use the value from wn: {units_friendly_name}"
msgstr "Aucune unité spécifiée. La valeur définie dans wn sera utilisée : {units_friendly_name}"

msgid "Cannot set headloss formula when wn is set. Set the headloss in the wn.options.hydraulic.headloss instead"
msgstr "Impossible de définir la formule de perte de charge lorsque wn est défini. Définissez-la plutôt dans wn.options.hydraulic.headloss."

msgid "headloss must be set if wn is not set: possible values are: H-W, D-W, C-M"
msgstr "La perte de charge doit être définie si wn n’est pas défini : les valeurs possibles sont : H-W, D-W, C-M"

msgid "No valid CRS found on input layers. Pipe lengths will not be calculated."
msgstr "Aucun SCR valide trouvé dans les couches d'entrée. Les longueurs de canalisations ne seront pas calculées."

msgid "Some input layers do not have a valid CRS. Pipe lengths may not be calculated correctly."
msgstr "Certaines couches d'entrée n'ont pas de SCR valide. Les longueurs de canalisations peuvent être mal calculées."

msgid "Multiple different CRSs found on input layers."
msgstr "Plusieurs SCR différents ont été trouvés dans les couches d'entrée."

#, python-brace-format
msgid "CRS {crs} is not valid."
msgstr "Le SCR {crs} n’est pas valide."

#, python-brace-format
msgid "{exception} is not a known set of units. Possible units are: "
msgstr "{exception} n'est pas un ensemble d'unités reconnu. Les unités possibles sont :"

#, python-brace-format
msgid "{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS', 'TANKS', 'PIPES', 'VALVES', 'PUMPS'."
msgstr "{value_error}. Les types de couches acceptés sont uniquement : 'JUNCTIONS', 'RESERVOIRS', 'TANKS', 'PIPES', 'VALVES', 'PUMPS'."

