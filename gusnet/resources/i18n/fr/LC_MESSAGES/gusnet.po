msgstr "Vitesse de rotation de base de la pompe"

#: gusnet/elements.py:732
msgid "Time-varying pattern for pump speed"
msgstr "Modèle variable dans le temps pour la vitesse de la pompe"

#: gusnet/elements.py:734
msgid "Initial operating status"
msgstr "État de fonctionnement initial"

#: gusnet/elements.py:736
msgid "Initial valve status (active, open, closed)"
msgstr "État initial de la vanne (actif, ouvert, fermé)"

