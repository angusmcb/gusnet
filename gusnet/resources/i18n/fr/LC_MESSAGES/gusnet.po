msgstr "Impossible de télécharger et d'installer gusnet_epanet. {exception}"

#: gusnet/dependencies.py:145
#, python-brace-format
msgid ""
"Missing necessary python packages {missing_deps}. Please see help for how"
" to fix this"
msgstr ""
"Packages Python nécessaires manquants {missing_deps}. Veuillez consulter "
"l’aide pour savoir comment résoudre ce problème"

#: gusnet/dependencies.py:153
msgid "Fetching gusnet_epanet is already in progress. Please wait and try again."
msgstr ""
"La récupération de gusnet_epanet est déjà en cours. Veuillez patienter "
"puis réessayer."

