#: gusnet/api.py:67
#, python-brace-format
msgid "No units specified. Will use the value from wn: {units_friendly_name}"
msgstr ""
"Keine Einheiten angegeben. Es wird der Wert aus wn verwendet: "
"{units_friendly_name}"

#: gusnet/api.py:197
msgid ""
"Cannot set headloss formula when wn is set. Set the headloss in the "
"wn.options.hydraulic.headloss instead"
msgstr ""
"Die Druckverlustformel kann nicht gesetzt werden, wenn wn gesetzt ist. "
"Setzen Sie den Druckverlust stattdessen in wn.options.hydraulic.headloss."

#: gusnet/api.py:207
msgid ""
"headloss must be set if wn is not set: possible values are: H-W, D-W, C-M"
msgstr ""
"Verlust muss eingestellt werden, wenn wn nicht gesetzt ist: Mögliche Werte "
"sind: H-W, D-W, C-M"

#: gusnet/api.py:219
msgid ""
"No valid CRS found on input layers. Pipe lengths will not be calculated."
msgstr ""
"Kein gueltiges CRS in den Eingabelayern gefunden. Rohrlaengen werden nicht "
"berechnet."

#: gusnet/api.py:222
msgid ""
"Some input layers do not have a valid CRS. Pipe lengths may not be "
"calculated correctly."
msgstr ""
"Einige Eingabelayer haben kein gueltiges CRS. Rohrlaengen werden "
"moeglicherweise nicht korrekt berechnet."

#: gusnet/api.py:225
msgid "Multiple different CRSs found on input layers."
msgstr "In den Eingabelayern wurden mehrere unterschiedliche CRS gefunden."

#: gusnet/api.py:264
#, python-brace-format
msgid "CRS {crs} is not valid."
msgstr "CRS {crs} ist nicht gültig."

#: gusnet/api.py:270
#, python-brace-format
msgid "{exception} is not a known set of units. Possible units are: "
msgstr "{exception} is not a known set of units. Possible units are:"

#: gusnet/api.py:279
#, python-brace-format
msgid ""
"{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS', "
"'TANKS', 'PIPES', 'VALVES', 'PUMPS'."
msgstr ""
"{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS', "
"'TANKS', 'PIPES', 'VALVES', 'PUMPS'."

