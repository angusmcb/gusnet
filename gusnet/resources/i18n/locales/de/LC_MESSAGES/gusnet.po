msgstr "Das Modell muss mindestens einen Knoten enthalten."

#: gusnet/verify_model.py:541
msgid "The model must contain at least one link (pipe, pump, or valve)."
msgstr "Das Modell muss mindestens eine Verbindung enthalten (Rohr, Pumpe oder Ventil)."

#: gusnet/verify_model.py:548
msgid "The model must contain at least one reservoir or tank."
msgstr "Das Modell muss mindestens ein Reservoir oder einen Tank enthalten."

#: gusnet/verify_model.py:556
#, python-brace-format
msgid "In {layer_type}, all elements must have {field_name} '{field_id}'"
msgstr "In {layer_type} müssen alle Elemente {field_name} „{field_id}“ haben"

#: gusnet/verify_model.py:567
msgid ""
"In Pipes, lengths could not be calculated and length field is missing or "
"contains blanks."
msgstr ""
"In Pipes konnten Langen nicht berechnet werden und das Feld length fehlt "
"oder enthalt leere Werte."

#: gusnet/verify_model.py:574
#, python-brace-format
msgid "In {layer_type}, {field_name} ({field_id}) must be numeric"
msgstr "In {layer_type} muss {field_name} ({field_id}) numerisch sein"

#: gusnet/verify_model.py:583
#, python-brace-format
msgid "In {layer_type}, {field_name} ({field_id}) must be boolean"
msgstr "In {layer_type} muss {field_name} ({field_id}) boolesch sein"

#: gusnet/verify_model.py:593
#, python-brace-format
msgid ""
"Valve type ({valve_type}) must be set for all valves and must be one of the "
"following values: {possible_values}"
msgstr ""
"Ventiltyp ({valve_type}) muss für alle Ventile gesetzt sein und einer der "
"folgenden Werte sein: {possible_values}"

#: gusnet/verify_model.py:601
#, python-brace-format
msgid ""
"{initial_setting_name} ({initial_setting}) must be set for all {valve_name}"
msgstr ""
"{initial_setting_name} ({initial_setting}) muss für alle {valve_name} "
"gesetzt sein"

#: gusnet/verify_model.py:613
#, python-brace-format
msgid ""
"Pump type ({pump_type}) must be set for all pumps and must be one of the "
"following values: {possible_values}"
msgstr ""
"Pumpentyp ({pump_type}) muss für alle Pumpen gesetzt sein und einer der "
"folgenden Werte sein: {possible_values}"

#: gusnet/verify_model.py:621
#, python-brace-format
msgid ""
"{pump_curve_name} ({pump_curve}) must be set for all pumps of type HEAD"
msgstr ""
"{pump_curve_name} ({pump_curve}) muss für alle Pumpen vom Typ HEAD gesetzt "
"sein"

#: gusnet/verify_model.py:630
#, python-brace-format
msgid ""
"{pump_power_name} ({pump_power}) must be set for all pumps of type POWER"
msgstr ""
"{pump_power_name} ({pump_power}) muss für alle Pumpen vom Typ POWER gesetzt "
"sein"

#: gusnet/verify_model.py:640
#, python-brace-format
msgid ""
"In {layer} problem reading {pattern_type}: {pattern_string} Patterns should "
"be a string of numeric values separated by a space, or a list of numeric "
"values."
msgstr ""
"In {layer} ist beim Lesen von {pattern_type} ein Problem aufgetreten: "
"{pattern_string}. Muster mussen eine Zeichenkette numerischer Werte sein, "
"getrennt durch Leerzeichen, oder eine Liste numerischer Werte."

#: gusnet/verify_model.py:653
#, python-brace-format
msgid ""
"In {layer}, problem reading {field_name}  \"{curve_string}\". {error_detail}"
" Curves should be of the form: (1, 2), (3.6, 4.7)"
msgstr ""
"In {layer} ist beim Lesen von {field_name} \"{curve_string}\" ein Problem "
"aufgetreten. {error_detail} Kurven sollten die Form haben: (1, 2), (3.6, "
"4.7)"

#: gusnet/verify_model.py:663
#, python-brace-format
msgid "Duplicate node names found: {dupes}"
msgstr "Doppelte Knotennamen gefunden: {dupes}"

#: gusnet/verify_model.py:669
#, python-brace-format
msgid "Duplicate link names found: {dupes}"
msgstr "Doppelte Verbindungsnamen gefunden: {dupes}"

#: gusnet/verify_model.py:677
#, python-brace-format
msgid ""
"In {layer_name}, the {field_name} values must be strings without spaces and "
"under 32 characters. Problem values: {names}"
msgstr ""
"In {layer_name} mussen die Werte von {field_name} Zeichenketten ohne "
"Leerzeichen und mit weniger als 32 Zeichen sein. Problemwerte: {names}"

