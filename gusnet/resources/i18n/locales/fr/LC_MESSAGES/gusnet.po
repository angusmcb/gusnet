#: gusnet/gusnet_processing/import_inp.py:51
#: gusnet/gusnet_processing/import_inp.py:98
msgid "Import from Epanet INP file"
msgstr "Importer depuis un fichier Epanet INP"

#: gusnet/gusnet_processing/import_inp.py:54
msgid ""
"\n"
"            Import all junctions, tanks, reservoirs, pipes, pumps and valves from an EPANET inp file.\n"
"            This will also save selected options from the .inp file.\n"
"            All units will be converted into the unit set selected. If not selected, it will default             to the unit set in the .inp file.\n"
"            "
msgstr ""
"Importe toutes les jonctions, les reservoirs, les bassins, les conduites, "
"les pompes et les vannes depuis un fichier INP EPANET.\n"
"            Cette action enregistre egalement les options selectionnees du "
"fichier .inp.\n"
"            Toutes les unites seront converties vers l'ensemble d'unites "
"selectionne. Si rien n'est selectionne, les unites du fichier .inp seront "
"utilisees par defaut."

