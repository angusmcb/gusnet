msgstr ""
"Le type de vanne ({valve_type}) doit être défini pour toutes les vannes et "
"doit être l’une des valeurs suivantes : {possible_values}"

#: gusnet/verify_model.py:601
#, python-brace-format
msgid ""
"{initial_setting_name} ({initial_setting}) must be set for all {valve_name}"
msgstr ""
"{initial_setting_name} ({initial_setting}) doit être défini pour toutes les "
"{valve_name}"

#: gusnet/verify_model.py:613
#, python-brace-format
msgid ""
"Pump type ({pump_type}) must be set for all pumps and must be one of the "
"following values: {possible_values}"
msgstr ""
"Le type de pompe ({pump_type}) doit être défini pour toutes les pompes et "
"doit être l’une des valeurs suivantes : {possible_values}"

#: gusnet/verify_model.py:621
#, python-brace-format
msgid ""
"{pump_curve_name} ({pump_curve}) must be set for all pumps of type HEAD"
msgstr ""
"{pump_curve_name} ({pump_curve}) doit être défini pour toutes les pompes de "
