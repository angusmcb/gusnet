#: gusnet/api.py:67
#, python-brace-format
msgid "No units specified. Will use the value from wn: {units_friendly_name}"
msgstr ""
"Aucune unité spécifiée. La valeur de wn sera utilisée : "
"{units_friendly_name}"

#: gusnet/api.py:197
msgid ""
"Cannot set headloss formula when wn is set. Set the headloss in the "
"wn.options.hydraulic.headloss instead"
msgstr ""
"Impossible de definir la formule de perte de charge lorsque wn est defini. "
"Definissez-la plutot dans wn.options.hydraulic.headloss."

#: gusnet/api.py:207
msgid ""
"headloss must be set if wn is not set: possible values are: H-W, D-W, C-M"
msgstr ""
"La perte de charge doit être définie si wn n’est pas défini : les valeurs "
"possibles sont : H-W, D-W, C-M"

#: gusnet/api.py:219
msgid ""
"No valid CRS found on input layers. Pipe lengths will not be calculated."
msgstr ""
"Aucun SCR valide trouve dans les couches d'entree. Les longueurs de "
"conduites ne seront pas calculees."

#: gusnet/api.py:222
msgid ""
"Some input layers do not have a valid CRS. Pipe lengths may not be "
"calculated correctly."
msgstr ""
"Certaines couches d'entree n'ont pas de SCR valide. Les longueurs de "
"conduites peuvent etre mal calculees."

#: gusnet/api.py:225
msgid "Multiple different CRSs found on input layers."
msgstr "Plusieurs SCR differents ont ete trouves dans les couches d'entree."

#: gusnet/api.py:264
#, python-brace-format
msgid "CRS {crs} is not valid."
msgstr "Le SCR {crs} n’est pas valide."

#: gusnet/api.py:270
#, python-brace-format
msgid "{exception} is not a known set of units. Possible units are: "
msgstr "{exception} is not a known set of units. Possible units are:"

#: gusnet/api.py:279
#, python-brace-format
msgid ""
"{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS', "
"'TANKS', 'PIPES', 'VALVES', 'PUMPS'."
msgstr ""
"{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS', "
"'TANKS', 'PIPES', 'VALVES', 'PUMPS'."

#: gusnet/dependencies.py:36
msgid "Fetching EPANET"
msgstr "Recuperation de EPANET"

#: gusnet/dependencies.py:114
msgid "Took too long to fetch and install."
msgstr "Le téléchargement et l’installation ont pris trop de temps."

#: gusnet/dependencies.py:117
msgid "Couldn't find Python"
msgstr "Python introuvable"

#: gusnet/dependencies.py:139
#, python-brace-format
msgid "Couldn't fetch and install gusnet_epanet. {exception}"
msgstr "Impossible de telecharger et d'installer gusnet_epanet. {exception}"

#: gusnet/dependencies.py:145
#, python-brace-format
msgid ""
"Missing necessary python packages {missing_deps}. Please see help for how to"
" fix this"
msgstr ""
"Packages Python nécessaires manquants {missing_deps}. Veuillez consulter "
"l’aide pour savoir comment résoudre ce problème"

#: gusnet/dependencies.py:153
msgid ""
"Fetching gusnet_epanet is already in progress. Please wait and try again."
msgstr ""
"La recuperation de gusnet_epanet est deja en cours. Veuillez patienter puis "
"reessayer."

