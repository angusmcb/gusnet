#: gusnet/verify_model.py:630
#, python-brace-format
msgid ""
"{pump_power_name} ({pump_power}) must be set for all pumps of type POWER"
msgstr ""
"{pump_power_name} ({pump_power}) doit être défini pour toutes les pompes de "
"type POWER"

#: gusnet/verify_model.py:640
#, python-brace-format
msgid ""
"In {layer} problem reading {pattern_type}: {pattern_string} Patterns should "
