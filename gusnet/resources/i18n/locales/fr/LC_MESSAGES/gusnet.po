msgstr "Plusieurs erreurs de verification ont ete trouvees:\n"

#: gusnet/verify_model.py:434
#, python-brace-format
msgid "The following links do not connect to a node at each end: {links}"
msgstr "Les liaisons suivantes ne sont pas connectees a un noeud a chacune de leurs extremites : {links}"

#: gusnet/verify_model.py:456
#, python-brace-format
msgid "{num_features} links have the same start and end nodes: {links}"
msgstr "{num_features} liaisons ont les memes noeuds de debut et de fin : {links}"

#: gusnet/verify_model.py:486
#, python-brace-format
msgid "The following junctions are not connected to any links: {nodes}"
msgstr "Les jonctions suivantes ne sont connectees a aucune liaison : {nodes}"

#: gusnet/verify_model.py:518
#, python-brace-format
msgid ""
"The following nodes have overlapping coordinates - it will not be possible "
"to know which node each link connects to: {nodes}"
msgstr ""
"Les noeuds suivants ont des coordonnees qui se chevauchent ; il sera "
"impossible de savoir a quel noeud chaque liaison est connectee : {nodes}"

#: gusnet/verify_model.py:527
msgid "The model is empty."
msgstr "Le modele est vide."

#: gusnet/verify_model.py:534
msgid "The model must contain at least one junction."
msgstr "Le modele doit contenir au moins une jonction."

#: gusnet/verify_model.py:541
msgid "The model must contain at least one link (pipe, pump, or valve)."
msgstr "Le modele doit contenir au moins un lien (conduite, pompe ou vanne)."

#: gusnet/verify_model.py:548
msgid "The model must contain at least one reservoir or tank."
msgstr "Le modele doit contenir au moins un reservoir ou un bassin."

#: gusnet/verify_model.py:556
#, python-brace-format
msgid "In {layer_type}, all elements must have {field_name} '{field_id}'"
msgstr ""
"Dans {layer_type}, tous les éléments doivent avoir {field_name} "
"« {field_id} »"

#: gusnet/verify_model.py:567
msgid ""
"In Pipes, lengths could not be calculated and length field is missing or "
"contains blanks."
msgstr ""
"Dans les conduites, les longueurs n'ont pas pu etre calculees et le champ de "
"longueur est absent ou contient des valeurs vides."

#: gusnet/verify_model.py:574
#, python-brace-format
msgid "In {layer_type}, {field_name} ({field_id}) must be numeric"
msgstr "Dans {layer_type}, {field_name} ({field_id}) doit etre numerique"

#: gusnet/verify_model.py:583
#, python-brace-format
msgid "In {layer_type}, {field_name} ({field_id}) must be boolean"
msgstr "Dans {layer_type}, {field_name} ({field_id}) doit etre booleen"

#: gusnet/verify_model.py:593
#, python-brace-format
msgid ""
"Valve type ({valve_type}) must be set for all valves and must be one of the "
