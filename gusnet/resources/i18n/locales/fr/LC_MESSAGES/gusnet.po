#: gusnet/elements.py:678
msgid ""
"Element identifier. If provided, it must be less than 32 characters and not "
"contain any spaces."
msgstr ""
"Identifiant de l’élément. S’il est fourni, il doit comporter moins de 32 "
"caractères et ne contenir aucun espace."

#: gusnet/elements.py:680
msgid "Height above datum. This is in metres or feet."
msgstr "Hauteur au-dessus du niveau de référence. En mètres ou pieds."

#: gusnet/elements.py:682
msgid "The demand for the element. Can be negative for inflows."
msgstr "La demande pour l’élément. Peut être négative pour les apports."

#: gusnet/elements.py:684
msgid "Time-varying multiplier pattern for base demand"
msgstr "Modèle multiplicateur variable dans le temps pour la demande de base"

#: gusnet/elements.py:686
msgid "Coefficient for flow through emitter at junction"
msgstr "Coefficient pour le débit à travers l’émetteur au nœud"

#: gusnet/elements.py:688
msgid "Initial water level in tank"
msgstr "Niveau d’eau initial dans la cuve"

#: gusnet/elements.py:690
msgid "Minimum allowable water level in tank"
msgstr "Niveau d’eau minimum autorisé dans la cuve"

#: gusnet/elements.py:692
msgid "Maximum allowable water level in tank"
msgstr "Niveau d’eau maximum autorisé dans la cuve"

#: gusnet/elements.py:694
msgid "Type of valve (PRV, PSV, PBV, FCV, TCV, GPV)"
msgstr "Type de vanne (PRV, PSV, PBV, FCV, TCV, GPV)"

#: gusnet/elements.py:696
msgid "Pressure setting for PRV, PBV, and PSV"
msgstr "Réglage de pression pour PRV, PBV et PSV"

#: gusnet/elements.py:698
msgid "Flow setting for FCV"
msgstr "Réglage de débit pour FCV"

#: gusnet/elements.py:700
msgid "Throttle setting for TCV"
msgstr "Réglage d’étranglement pour TCV"

#: gusnet/elements.py:702
msgid "Internal diameter of pipe"
msgstr "Diamètre interne de la canalisation"

#: gusnet/elements.py:704
msgid "Diameter of tank"
msgstr "Diamètre de la cuve"

#: gusnet/elements.py:706
msgid "Minimum volume of water in tank"
msgstr "Volume minimum d’eau dans la cuve"

#: gusnet/elements.py:708
msgid "Volume curve relating tank level to volume"
msgstr "Courbe de volume reliant le niveau de la cuve au volume"

#: gusnet/elements.py:710
msgid "Whether tank can overflow when full"
msgstr "Si la cuve peut déborder lorsqu’elle est pleine"

#: gusnet/elements.py:712
msgid "Hydraulic head at reservoir"
msgstr "Hauteur hydraulique au réservoir"

#: gusnet/elements.py:714
msgid "Time-varying pattern for reservoir head"
msgstr "Modèle variable dans le temps pour la hauteur du réservoir"

#: gusnet/elements.py:716
msgid ""
"Physical length of pipe. If left blank this will be calculated automatically"
msgstr ""
"Longueur physique de la canalisation. Si laissé vide, sera calculé "
"automatiquement"

#: gusnet/elements.py:718
msgid "Pipe roughness coefficient for headloss calculation"
msgstr ""
"Coefficient de rugosité de la canalisation pour le calcul de la perte de "
"charge"

#: gusnet/elements.py:720
msgid "Minor loss coefficient for fittings and bends"
msgstr "Coefficient de perte mineure pour les raccords et coudes"

#: gusnet/elements.py:722
msgid "Whether pipe has check valve to prevent backflow"
msgstr ""
"Si la canalisation possède une vanne de retenue pour empêcher le reflux"

#: gusnet/elements.py:724
msgid "How is pump described (by power or by head curve)"
msgstr ""
"Comment la pompe est-elle décrite (par puissance ou par courbe de hauteur)"

#: gusnet/elements.py:726
msgid "Flow vs head curve for pump"
msgstr "Courbe débit-hauteur pour la pompe"

#: gusnet/elements.py:728
msgid "Power rating of pump"
msgstr "Puissance nominale de la pompe"

#: gusnet/elements.py:730
msgid "Base rotational speed of pump"
msgstr "Vitesse de rotation de base de la pompe"

#: gusnet/elements.py:732
msgid "Time-varying pattern for pump speed"
msgstr "Modèle variable dans le temps pour la vitesse de la pompe"

#: gusnet/elements.py:734
msgid "Initial operating status"
msgstr "État de fonctionnement initial"

#: gusnet/elements.py:736
msgid "Initial valve status (active, open, closed)"
msgstr "État initial de la vanne (actif, ouvert, fermé)"

#: gusnet/elements.py:738
msgid "Head loss curve (flow vs head loss) for general purpose valve"
msgstr ""
"Courbe de perte de charge (débit vs perte de charge) pour vanne polyvalente"

#: gusnet/elements.py:740
msgid "Initial water quality concentration for water quality analysis"
msgstr ""
"Concentration initiale de qualité de l’eau pour l’analyse de la qualité"

#: gusnet/elements.py:742
msgid ""
"Fraction of tank volume for mixing model for two-compartment mixing model"
msgstr ""
"Fraction du volume de la cuve pour le modèle de mélange à deux compartiments"

#: gusnet/elements.py:744
msgid "Tank mixing model type for water quality analysis"
msgstr ""
"Type de modèle de mélange de cuve pour l’analyse de la qualité de l’eau"

#: gusnet/elements.py:746
msgid "Bulk reaction rate coefficient for water quality analysis"
msgstr ""
"Coefficient de taux de réaction globale pour l’analyse de la qualité de "
"l’eau"

#: gusnet/elements.py:748
msgid "Wall reaction rate coefficient for water quality analysis"
msgstr ""
"Coefficient de taux de réaction de paroi pour l’analyse de la qualité de "
"l’eau"

#: gusnet/elements.py:750
msgid "Pump efficiency curve (flow vs efficiency) for energy use analysis"
msgstr ""
"Courbe d’efficacité de la pompe (débit vs efficacité) pour l’analyse "
"énergétique"

#: gusnet/elements.py:752
msgid "Time-varying pattern for energy price"
msgstr "Modèle variable dans le temps pour le prix de l’énergie"

#: gusnet/elements.py:754
msgid "Energy price per kW hour for energy use analysis"
msgstr "Prix de l’énergie par kWh pour l’analyse énergétique"

#: gusnet/elements.py:757
msgid "Water demand at node"
msgstr "Demande en eau au nœud"

#: gusnet/elements.py:759
msgid "Hydraulic head at node"
msgstr "Hauteur hydraulique au nœud"

#: gusnet/elements.py:761
msgid "Water pressure at node"
msgstr "Pression d’eau au nœud"

#: gusnet/elements.py:763
msgid "Water flow rate through link"
msgstr "Débit d’eau à travers le lien"

#: gusnet/elements.py:765
msgid "Head loss across link"
msgstr "Perte de charge à travers le lien"

#: gusnet/elements.py:767
msgid "Head loss proportional to length of pipe"
msgstr "Perte de charge proportionnelle à la longueur de la canalisation"

#: gusnet/elements.py:769
msgid "Water velocity in link"
msgstr "Vitesse de l’eau dans le lien"

#: gusnet/elements.py:771
msgid "Water quality concentration"
msgstr "Concentration de qualité de l’eau"

#: gusnet/elements.py:773
msgid "Rate of water quality reaction"
msgstr "Taux de réaction de la qualité de l’eau"

#: gusnet/elements.py:792
msgid "Flow units for the model"
msgstr "Unités de débit du modèle"

#: gusnet/elements.py:794
msgid ""
"Flow units will determine the units of other units used in the model as "
"well. Selecting a metric-based unit set means everything will be metric, "
"wheras selecting an imperial measure means everything will be imperial."
msgstr ""
"Les unites de debit determinent aussi les unites des autres grandeurs du "
"modele. En choisissant un systeme metrique, tout sera en metrique ; en "
"choisissant un systeme imperial, tout sera en imperial."

#: gusnet/elements.py:801
msgid "Formula to use for headloss calculations"
msgstr "Formule a utiliser pour les calculs de perte de charge"

#: gusnet/elements.py:807
msgid "Duration of the simulation in hours (or 0 for single period)"
msgstr "Duree de la simulation en heures (ou 0 pour une seule periode)"

#: gusnet/elements.py:815
msgid "Global multiplier for all demands in the model"
msgstr "Multiplicateur global pour toutes les demandes du modele"

#: gusnet/elements.py:824
msgid "Default pattern to use for any pattern fields left blank"
msgstr "Motif par defaut a utiliser pour les champs de motif laisses vides"

#: gusnet/elements.py:831
msgid "Exponent for emitter calculations"
msgstr "Exposant pour les calculs d'emetteur"

#: gusnet/elements.py:842
msgid "Whether to model demands as fixed or pressure dependent"
msgstr "Indique si les demandes sont modelees comme fixes ou dependantes de la pression"

#: gusnet/elements.py:848
msgid "Minimum pressure for pressure dependent demand calculations"
msgstr "Pression minimale pour les calculs de demande dependante de la pression"

#: gusnet/elements.py:855
msgid "Required pressure for pressure dependent demand calculations"
msgstr "Pression requise pour les calculs de demande dependante de la pression"

#: gusnet/elements.py:862
msgid "Exponent for pressure dependent demand calculations"
msgstr "Exposant pour les calculs de demande dependante de la pression"

#: gusnet/elements.py:878
msgid "Price of energy per kW hour for energy calculations"
msgstr "Prix de l'energie par kWh pour les calculs energetiques"

#: gusnet/elements.py:885
msgid "Pattern of price multiplier to use for energy calculations"
msgstr "Motif de multiplicateur de prix a utiliser pour les calculs energetiques"

#: gusnet/elements.py:891
msgid "Global efficiency of pumps for energy calculations - as a percentage"
msgstr "Efficacite globale des pompes pour les calculs energetiques - en pourcentage"

#: gusnet/elements.py:898
msgid "Demand charge for energy calculations"
msgstr "Tarif de puissance pour les calculs energetiques"

#: gusnet/elements.py:908
msgid "Type of water quality analysis to do"
msgstr "Type d'analyse de qualite de l'eau a effectuer"

#: gusnet/elements.py:914
msgid "Mass unit to use for water quality analysis"
msgstr "Unite de masse a utiliser pour l'analyse de qualite de l'eau"

#: gusnet/elements.py:920
msgid "Relative diffusivity for water quality analysis"
msgstr "Diffusivite relative pour l'analyse de qualite de l'eau"

#: gusnet/elements.py:927
msgid "Node to track for trace analysis (if quality parameter is TRACE)"
msgstr ""
"Noeud a suivre pour l analyse de trace (si le parametre de qualite est "
"TRACE)"

#: gusnet/elements.py:933
msgid "Tolerance for water quality convergence in extended period simulations"
msgstr "Tolerance de convergence de la qualite de l'eau dans les simulations de longue duree"

#: gusnet/elements.py:941
msgid "Order of the bulk reaction for water quality analysis"
msgstr "Ordre de la reaction en masse pour l'analyse de la qualite de l'eau"

#: gusnet/elements.py:948
msgid "Order of the wall reaction for water quality analysis"
msgstr "Ordre de la reaction de paroi pour l'analyse de la qualite de l'eau"

#: gusnet/elements.py:954
msgid "Global bulk coefficient for water quality analysis"
msgstr "Coefficient global de reaction en masse pour l'analyse de la qualite de l'eau"

#: gusnet/elements.py:961
msgid "Global wall coefficient for water quality analysis"
msgstr "Coefficient global de reaction de paroi pour l'analyse de la qualite de l'eau"

#: gusnet/elements.py:970
msgid ""
"Limiting concentration for water quality analysis (concentration below which"
" reactions are assumed to stop)"
msgstr ""
"Concentration limite pour l'analyse de la qualite de l'eau (concentration "
"en dessous de laquelle les reactions sont supposees s'arreter)"

#: gusnet/elements.py:979
msgid ""
"Correlation for calculating wall reaction coefficient based on pipe diameter"
" (if 0, wall coefficient will be constant)"
msgstr ""
"Correlation pour calculer le coefficient de reaction de paroi en fonction "
"du diametre de la conduite (si 0, le coefficient de paroi sera constant)"

#: gusnet/epanet_wrapper.py:171
msgid ""
"System hydraulically unbalanced - convergence to a hydraulic solution was "
"not achieved in the allowed number of trials"
msgstr ""
"Systeme hydrauliquement desequilibre - la convergence vers une solution "
"hydraulique n'a pas ete atteinte dans le nombre d'essais autorise"

#: gusnet/epanet_wrapper.py:174
msgid ""
