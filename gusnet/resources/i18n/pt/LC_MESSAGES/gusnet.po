#: gusnet/api.py:67
#, python-brace-format
msgid "No units specified. Will use the value from wn: {units_friendly_name}"
msgstr ""
"Nenhuma unidade especificada. Será usado o valor de wn: "
"{units_friendly_name}"

#: gusnet/api.py:197
msgid ""
"Cannot set headloss formula when wn is set. Set the headloss in the "
"wn.options.hydraulic.headloss instead"
msgstr ""
"Nao e possivel definir a formula de perda de carga quando wn esta definido. "
"Defina a perda de carga em wn.options.hydraulic.headloss."

#: gusnet/api.py:207
msgid ""
"headloss must be set if wn is not set: possible values are: H-W, D-W, C-M"
msgstr ""
"a perda de altura deve ser definida se wn não estiver definido: os valores "
"possíveis são: H-W, D-W, C-M"

#: gusnet/api.py:219
msgid ""
"No valid CRS found on input layers. Pipe lengths will not be calculated."
msgstr ""
"Nenhum SRC valido encontrado nas camadas de entrada. Os comprimentos das "
"tubulacoes nao serao calculados."

#: gusnet/api.py:222
msgid ""
"Some input layers do not have a valid CRS. Pipe lengths may not be "
"calculated correctly."
msgstr ""
"Algumas camadas de entrada nao possuem SRC valido. Os comprimentos das "
"tubulacoes podem nao ser calculados corretamente."

#: gusnet/api.py:225
msgid "Multiple different CRSs found on input layers."
msgstr "Foram encontrados varios SRC diferentes nas camadas de entrada."

#: gusnet/api.py:264
#, python-brace-format
msgid "CRS {crs} is not valid."
msgstr "CRS {crs} não é válido."

#: gusnet/api.py:270
#, python-brace-format
msgid "{exception} is not a known set of units. Possible units are: "
msgstr "{exception} is not a known set of units. Possible units are:"

#: gusnet/api.py:279
#, python-brace-format
msgid ""
"{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS', "
"'TANKS', 'PIPES', 'VALVES', 'PUMPS'."
msgstr ""
"{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS', "
"'TANKS', 'PIPES', 'VALVES', 'PUMPS'."

