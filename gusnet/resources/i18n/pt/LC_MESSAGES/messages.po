#: gusnet/epanet_wrapper.py
#, python-brace-format
msgid "EPANET returned warning code {error_code}: {warning_text}"
msgstr "EPANET retornou o código de aviso {error_code}: {warning_text}"

#: gusnet/epanet_wrapper.py
#, python-brace-format
msgid ""
"EPANET returned warning code {error_code} at simulation time {time}: "
"{warning_text}"
msgstr ""
"EPANET retornou o código de aviso {error_code} no tempo de simulação "
"{time}: {warning_text}"

#: gusnet/epanet_wrapper.py
msgid ""
"System hydraulically unbalanced - convergence to a hydraulic solution was"
" not achieved in the allowed number of trials"
msgstr ""
"Sistema hidraulicamente desequilibrado - a convergencia para uma solucao "
"hidraulica nao foi alcancada no numero permitido de tentativas"

#: gusnet/epanet_wrapper.py
msgid ""
"System may be hydraulically unstable - hydraulic convergence was only "
"achieved after the status of all links was held fixed"
msgstr ""
"O sistema pode estar hidraulicamente instavel - a convergencia hidraulica"
" so foi alcancada apos manter fixo o status de todos os links"

#: gusnet/epanet_wrapper.py
msgid ""
"System disconnected - one or more nodes with positive demands were "
"disconnected for all supply sources"
msgstr ""
"Sistema desconectado - um ou mais nos com demanda positiva ficaram "
"desconectados de todas as fontes de abastecimento"

#: gusnet/epanet_wrapper.py
msgid ""
"Pumps cannot deliver enough flow or head - one or more pumps were forced "
"to either shut down (due to insufficient head) or operate beyond the "
"maximum rated flow"
msgstr ""
"As bombas nao conseguem fornecer vazao ou carga suficientes - uma ou mais"
" bombas foram forcadas a desligar (por carga insuficiente) ou operar "
"acima da vazao nominal maxima"

#: gusnet/epanet_wrapper.py
msgid ""
"Valves cannot deliver enough flow - one or more flow control valves could"
" not deliver the required flow even when fully open"
msgstr ""
"As valvulas nao conseguem fornecer vazao suficiente - uma ou mais "
"valvulas de controle de vazao nao conseguiram fornecer a vazao requerida "
"mesmo totalmente abertas"

#: gusnet/epanet_wrapper.py
msgid ""
"System has negative pressures - negative pressures occurred at one or "
"more junctions with positive demand"
msgstr ""
"O sistema tem pressoes negativas - ocorreram pressoes negativas em um ou "
"mais nos com demanda positiva"

#: gusnet/epanet_wrapper.py
msgid "insufficient memory available"
msgstr "memoria insuficiente disponivel"

#: gusnet/epanet_wrapper.py
