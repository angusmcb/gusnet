msgstr "Nao foi possivel baixar e instalar gusnet_epanet. {exception}"

#: gusnet/dependencies.py
#, python-brace-format
msgid ""
"Missing necessary python packages {missing_deps}. Please see help for how"
" to fix this"
msgstr ""
"Faltam pacotes python necessários {missing_deps}. Consulte a ajuda para "
"saber como corrigir isso"

#: gusnet/dependencies.py
msgid "Fetching gusnet_epanet is already in progress. Please wait and try again."
msgstr ""
"O download de gusnet_epanet ja esta em andamento. Aguarde e tente "
"novamente."

