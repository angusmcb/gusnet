msgstr ""
"{pump_power_name} ({pump_power}) moet voor alle pompen van type POWER worden"
" ingesteld"

#: gusnet/verify_model.py:640
#, python-brace-format
msgid ""
"In {layer} problem reading {pattern_type}: {pattern_string} Patterns should "
"be a string of numeric values separated by a space, or a list of numeric "
"values."
msgstr ""
"In {layer} is een probleem opgetreden bij het lezen van {pattern_type}: "
"{pattern_string}. Patronen moeten een tekenreeks met numerieke waarden zijn, "
"gescheiden door spaties, of een lijst met numerieke waarden."

#: gusnet/verify_model.py:653
#, python-brace-format
msgid ""
"In {layer}, problem reading {field_name}  \"{curve_string}\". {error_detail}"
" Curves should be of the form: (1, 2), (3.6, 4.7)"
msgstr ""
"In {layer} is een probleem opgetreden bij het lezen van {field_name} "
"\"{curve_string}\". {error_detail} Curven moeten de vorm hebben: (1, 2), "
"(3.6, 4.7)"

