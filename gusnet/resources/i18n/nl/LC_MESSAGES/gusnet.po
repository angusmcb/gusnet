#: gusnet/verify_model.py:613
#, python-brace-format
msgid ""
"Pump type ({pump_type}) must be set for all pumps and must be one of the "
"following values: {possible_values}"
msgstr ""
"Pomp type ({pump_type}) moet voor alle pompen worden ingesteld en moet een "
"van de volgende waarden zijn: {possible_values}"

#: gusnet/verify_model.py:621
#, python-brace-format
msgid ""
"{pump_curve_name} ({pump_curve}) must be set for all pumps of type HEAD"
msgstr ""
"{pump_curve_name} ({pump_curve}) moet voor alle pompen van type HEAD worden "
"ingesteld"

