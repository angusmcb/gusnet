#: gusnet/api.py:67
#, python-brace-format
msgid "No units specified. Will use the value from wn: {units_friendly_name}"
msgstr ""
"Geen eenheden opgegeven. De waarde uit wn wordt gebruikt: "
"{units_friendly_name}"

#: gusnet/api.py:197
msgid ""
"Cannot set headloss formula when wn is set. Set the headloss in the "
"wn.options.hydraulic.headloss instead"
msgstr ""
"Kan de drukverliesformule niet instellen wanneer wn is ingesteld. Stel de"
" drukverlieswaarde in via wn.options.hydraulic.headloss."

#: gusnet/api.py:207
msgid "headloss must be set if wn is not set: possible values are: H-W, D-W, C-M"
msgstr ""
"hoogteverlies moet worden ingesteld als wn niet is ingesteld: mogelijke "
"waarden zijn: H-W, D-W, C-M"

#: gusnet/api.py:219
msgid "No valid CRS found on input layers. Pipe lengths will not be calculated."
msgstr ""
"Geen geldig CRS gevonden in invoerlagen. Leidinglengtes worden niet "
"berekend."

#: gusnet/api.py:222
msgid ""
"Some input layers do not have a valid CRS. Pipe lengths may not be "
"calculated correctly."
msgstr ""
"Sommige invoerlagen hebben geen geldig CRS. Leidinglengtes worden "
"mogelijk niet correct berekend."

#: gusnet/api.py:225
msgid "Multiple different CRSs found on input layers."
msgstr "Er zijn meerdere verschillende CRS gevonden in de invoerlagen."

#: gusnet/api.py:264
#, python-brace-format
msgid "CRS {crs} is not valid."
msgstr "CRS {crs} is niet geldig."

#: gusnet/api.py:270
#, python-brace-format
msgid "{exception} is not a known set of units. Possible units are: "
msgstr "{exception} is not a known set of units. Possible units are:"

#: gusnet/api.py:279
#, python-brace-format
msgid ""
"{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS',"
" 'TANKS', 'PIPES', 'VALVES', 'PUMPS'."
msgstr ""
"{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS',"
" 'TANKS', 'PIPES', 'VALVES', 'PUMPS'."

#: gusnet/dependencies.py:36
msgid "Fetching EPANET"
msgstr "EPANET ophalen"

#: gusnet/dependencies.py:114
msgid "Took too long to fetch and install."
msgstr "Het ophalen en installeren duurde te lang."

#: gusnet/dependencies.py:117
msgid "Couldn't find Python"
msgstr "Kon Python niet vinden"

#: gusnet/dependencies.py:139
#, python-brace-format
