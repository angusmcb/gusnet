msgstr "Hoe wordt pomp beschreven (door vermogen of door hoogtecurve)"

#: gusnet/elements.py
msgid "Flow vs head curve for pump"
msgstr "Stroom versus hoogtecurve voor pomp"

#: gusnet/elements.py
