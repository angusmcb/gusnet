#: gusnet/elements.py
msgid ""
"Element identifier. If provided, it must be less than 32 characters and "
"not contain any spaces."
msgstr ""
"Elementidentificatie. Indien opgegeven, moet het minder dan 32 tekens "
"zijn en geen spaties bevatten."

#: gusnet/elements.py
msgid "Height above datum. This is in metres or feet."
msgstr "Hoogte boven referentiepunt. Dit is in meters of voeten."

#: gusnet/elements.py
msgid "The demand for the element. Can be negative for inflows."
msgstr "De vraag voor het element. Kan negatief zijn voor instromen."

