msgstr "Er zijn meerdere verificatiefouten gevonden:\n"

#: gusnet/verify_model.py
#, python-brace-format
msgid "The following links do not connect to a node at each end: {links}"
msgstr ""
"De volgende verbindingen zijn niet aan beide uiteinden met een knooppunt "
"verbonden: {links}"

#: gusnet/verify_model.py
#, python-brace-format
msgid "{num_features} links have the same start and end nodes: {links}"
msgstr ""
"{num_features} verbindingen hebben dezelfde begin- en eindknooppunten: "
"{links}"

#: gusnet/verify_model.py
#, python-brace-format
msgid "The following junctions are not connected to any links: {nodes}"
msgstr "De volgende knooppunten zijn niet verbonden met enige verbinding: {nodes}"

#: gusnet/verify_model.py
#, python-brace-format
msgid ""
"The following nodes have overlapping coordinates - it will not be "
"possible to know which node each link connects to: {nodes}"
msgstr ""
"De volgende knooppunten hebben overlappende coordinaten; daardoor is niet"
" te bepalen met welk knooppunt elke verbinding verbonden is: {nodes}"

#: gusnet/verify_model.py
msgid "The model is empty."
msgstr "Het model is leeg."

#: gusnet/verify_model.py
msgid "The model must contain at least one junction."
msgstr "Het model moet ten minste een knooppunt bevatten."

#: gusnet/verify_model.py
msgid "The model must contain at least one link (pipe, pump, or valve)."
msgstr ""
"Het model moet ten minste een verbinding bevatten (leiding, pomp of "
"ventiel)."

#: gusnet/verify_model.py
msgid "The model must contain at least one reservoir or tank."
msgstr "Het model moet ten minste een reservoir of tank bevatten."

#: gusnet/verify_model.py
#, python-brace-format
msgid "In {layer_type}, all elements must have {field_name} '{field_id}'"
msgstr "In {layer_type} moeten alle elementen {field_name} '{field_id}' hebben"

#: gusnet/verify_model.py
msgid ""
"In Pipes, lengths could not be calculated and length field is missing or "
"contains blanks."
msgstr ""
"In Pipes konden lengtes niet worden berekend en ontbreekt het veld "
"length, of bevat het lege waarden."

#: gusnet/verify_model.py
#, python-brace-format
msgid "In {layer_type}, {field_name} ({field_id}) must be numeric"
msgstr "In {layer_type} moet {field_name} ({field_id}) numeriek zijn"

#: gusnet/verify_model.py
#, python-brace-format
msgid "In {layer_type}, {field_name} ({field_id}) must be boolean"
msgstr "In {layer_type} moet {field_name} ({field_id}) booleaans zijn"

#: gusnet/verify_model.py
#, python-brace-format
msgid ""
"Valve type ({valve_type}) must be set for all valves and must be one of "
"the following values: {possible_values}"
msgstr ""
"Ventieltype ({valve_type}) moet voor alle ventielen worden ingesteld en "
"moet een van de volgende waarden zijn: {possible_values}"

#: gusnet/verify_model.py
#, python-brace-format
msgid ""
"{initial_setting_name} ({initial_setting}) must be set for all "
"{valve_name}"
msgstr ""
"{initial_setting_name} ({initial_setting}) moet voor alle {valve_name} "
"worden ingesteld"

#: gusnet/verify_model.py
#, python-brace-format
msgid ""
"Pump type ({pump_type}) must be set for all pumps and must be one of the "
"following values: {possible_values}"
msgstr ""
"Pomp type ({pump_type}) moet voor alle pompen worden ingesteld en moet "
"een van de volgende waarden zijn: {possible_values}"

#: gusnet/verify_model.py
#, python-brace-format
msgid "{pump_curve_name} ({pump_curve}) must be set for all pumps of type HEAD"
msgstr ""
"{pump_curve_name} ({pump_curve}) moet voor alle pompen van type HEAD "
"worden ingesteld"

#: gusnet/verify_model.py
#, python-brace-format
msgid "{pump_power_name} ({pump_power}) must be set for all pumps of type POWER"
msgstr ""
"{pump_power_name} ({pump_power}) moet voor alle pompen van type POWER "
"worden ingesteld"

#: gusnet/verify_model.py
#, python-brace-format
msgid ""
"In {layer} problem reading {pattern_type}: {pattern_string} Patterns "
"should be a string of numeric values separated by a space, or a list of "
"numeric values."
msgstr ""
"In {layer} is een probleem opgetreden bij het lezen van {pattern_type}: "
"{pattern_string}. Patronen moeten een tekenreeks met numerieke waarden "
"zijn, gescheiden door spaties, of een lijst met numerieke waarden."

#: gusnet/verify_model.py
#, python-brace-format
msgid ""
"In {layer}, problem reading {field_name}  \"{curve_string}\". "
"{error_detail} Curves should be of the form: (1, 2), (3.6, 4.7)"
msgstr ""
"In {layer} is een probleem opgetreden bij het lezen van {field_name} "
"\"{curve_string}\". {error_detail} Curven moeten de vorm hebben: (1, 2), "
"(3.6, 4.7)"

#: gusnet/verify_model.py
#, python-brace-format
