msgid "Initial water quality concentration for water quality analysis"
msgstr "Initiële waterkwaliteitsconcentratie voor waterkwaliteitsanalyse"

#: gusnet/elements.py
msgid "Fraction of tank volume for mixing model for two-compartment mixing model"
msgstr "Fractie van tankvolume voor mengmodel met twee compartimenten"

#: gusnet/elements.py
msgid "Tank mixing model type for water quality analysis"
msgstr "Tankmengmodeltype voor waterkwaliteitsanalyse"

#: gusnet/elements.py
msgid "Bulk reaction rate coefficient for water quality analysis"
msgstr "Bulkreactiesnelheidscoëfficiënt voor waterkwaliteitsanalyse"

#: gusnet/elements.py
msgid "Wall reaction rate coefficient for water quality analysis"
msgstr "Wandreactiesnelheidscoëfficiënt voor waterkwaliteitsanalyse"

#: gusnet/elements.py
