msgstr "Fysieke lengte van leiding. Indien leeg wordt dit automatisch berekend"

#: gusnet/elements.py
msgid "Pipe roughness coefficient for headloss calculation"
msgstr "Leidingruwheidscoëfficiënt voor hoogteverliesberekening"

