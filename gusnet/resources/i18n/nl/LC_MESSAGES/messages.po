msgstr "Volumecurve die tankniveau aan volume koppelt"

#: gusnet/elements.py
msgid "Whether tank can overflow when full"
msgstr "Of tank kan overlopen als deze vol is"

#: gusnet/elements.py
msgid "Hydraulic head at reservoir"
msgstr "Hydraulische hoogte bij reservoir"

#: gusnet/elements.py
msgid "Time-varying pattern for reservoir head"
msgstr "Tijdafhankelijk patroon voor reservoirhoogte"

#: gusnet/elements.py
msgid ""
"Physical length of pipe. If left blank this will be calculated "
