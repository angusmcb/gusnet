#, python-brace-format
msgid "No units specified. Will use the value from wn: {units_friendly_name}"
msgstr "Geen eenheden opgegeven. De waarde uit wn wordt gebruikt: {units_friendly_name}"

msgid "Cannot set headloss formula when wn is set. Set the headloss in the wn.options.hydraulic.headloss instead"
msgstr "Kan de drukverliesformule niet instellen wanneer wn is ingesteld. Stel de drukverlieswaarde in via wn.options.hydraulic.headloss."

msgid "headloss must be set if wn is not set: possible values are: H-W, D-W, C-M"
msgstr "hoogteverlies moet worden ingesteld als wn niet is ingesteld: mogelijke waarden zijn: H-W, D-W, C-M"

msgid "No valid CRS found on input layers. Pipe lengths will not be calculated."
msgstr "Geen geldig CRS gevonden in invoerlagen. Leidinglengtes worden niet berekend."

msgid "Some input layers do not have a valid CRS. Pipe lengths may not be calculated correctly."
msgstr "Sommige invoerlagen hebben geen geldig CRS. Leidinglengtes worden mogelijk niet correct berekend."

msgid "Multiple different CRSs found on input layers."
msgstr "Er zijn meerdere verschillende CRS gevonden in de invoerlagen."

#, python-brace-format
msgid "CRS {crs} is not valid."
msgstr "CRS {crs} is niet geldig."

#, python-brace-format
msgid "{exception} is not a known set of units. Possible units are: "
msgstr "{exception} is not a known set of units. Possible units are:"

#, python-brace-format
msgid "{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS', 'TANKS', 'PIPES', 'VALVES', 'PUMPS'."
msgstr "{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS', 'TANKS', 'PIPES', 'VALVES', 'PUMPS'."

