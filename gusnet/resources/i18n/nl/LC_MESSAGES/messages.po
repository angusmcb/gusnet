msgstr "Tijdelijke map wordt gebruikt: {folder}"

#: gusnet/gusnet_processing/run_simulation.py
msgid "Writing EPANET input file"
msgstr "EPANET-invoerbestand schrijven"

#: gusnet/gusnet_processing/run_simulation.py
msgid "Run EPANET simulation"
msgstr "EPANET-simulatie uitvoeren"

#: gusnet/gusnet_processing/run_simulation.py
msgid "Process results output file"
msgstr "Uitvoerbestand met resultaten verwerken"

#: gusnet/gusnet_processing/run_simulation.py
msgid "Creating output layers"
msgstr "Uitvoerlagen maken"

#: gusnet/gusnet_processing/run_simulation.py
msgid "Export to Epanet INP file"
msgstr "Exporteren naar Epanet INP-bestand"

#: gusnet/gusnet_processing/run_simulation.py
msgid ""
"This will take all of the model layers (junctions, tanks, reservoirs, "
"pipes, valves, pumps),combine them with the chosen options, and produce "
"an EPANET '.inp' file which can be run / viewed in other software."
msgstr ""
"Dit neemt alle modellagen (knooppunten, tanks, reservoirs, leidingen, "
"kleppen en pompen), combineert ze met de gekozen opties en maakt een "
"EPANET-'.inp'-bestand dat in andere software kan worden uitgevoerd of "
"bekeken."

#: gusnet/gusnet_processing/run_simulation.py
msgid "Output .inp file"
msgstr "Uitvoer .inp bestand"

#: gusnet/gusnet_processing/run_simulation.py
msgid "Export Inp File"
msgstr "Inp-bestand exporteren"

