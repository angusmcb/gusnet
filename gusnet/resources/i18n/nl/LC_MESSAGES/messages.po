#, python-brace-format
msgid "EPANET returned warning code {error_code}: {warning_text}"
msgstr "EPANET gaf waarschuwingscode {error_code} terug: {warning_text}"

#, python-brace-format
msgid "EPANET returned warning code {error_code} at simulation time {time}: {warning_text}"
msgstr "EPANET gaf waarschuwingscode {error_code} terug op simulatietijd {time}: {warning_text}"

msgid "System hydraulically unbalanced - convergence to a hydraulic solution was not achieved in the allowed number of trials"
msgstr "Systeem hydraulisch uit balans: convergentie naar een hydraulische oplossing is niet bereikt binnen het toegestane aantal pogingen"

msgid "System may be hydraulically unstable - hydraulic convergence was only achieved after the status of all links was held fixed"
msgstr "Systeem kan hydraulisch instabiel zijn: hydraulische convergentie werd alleen bereikt nadat de status van alle verbindingen vast was gehouden"

msgid "System disconnected - one or more nodes with positive demands were disconnected for all supply sources"
msgstr "Systeem losgekoppeld: een of meer knooppunten met positieve vraag waren losgekoppeld van alle aanvoerbronnen"

msgid "Pumps cannot deliver enough flow or head - one or more pumps were forced to either shut down (due to insufficient head) or operate beyond the maximum rated flow"
msgstr "Pompen kunnen niet genoeg debiet of opvoerhoogte leveren: een of meer pompen werden gedwongen uit te schakelen (door onvoldoende opvoerhoogte) of boven het maximale nominale debiet te werken"

msgid "Valves cannot deliver enough flow - one or more flow control valves could not deliver the required flow even when fully open"
msgstr "Kleppen kunnen niet genoeg debiet leveren: een of meer debietregelkleppen konden het vereiste debiet niet leveren, zelfs niet volledig geopend"

msgid "System has negative pressures - negative pressures occurred at one or more junctions with positive demand"
msgstr "Systeem heeft negatieve drukken: negatieve drukken traden op bij een of meer knooppunten met positieve vraag"

