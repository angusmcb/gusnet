#: gusnet/api.py
#, python-brace-format
msgid "No units specified. Will use the value from wn: {units_friendly_name}"
msgstr "未指定单位。将使用 wn 中的值：{units_friendly_name}"

#: gusnet/api.py
msgid ""
"Cannot set headloss formula when wn is set. Set the headloss in the "
"wn.options.hydraulic.headloss instead"
msgstr "设置了 wn 时无法设置水头损失公式。请改为在 wn.options.hydraulic.headloss 中设置水头损失"

#: gusnet/api.py
msgid "headloss must be set if wn is not set: possible values are: H-W, D-W, C-M"
msgstr "如果未设置 wn，必须设置 headloss：可选值为 H-W、D-W、C-M"

#: gusnet/api.py
msgid "No valid CRS found on input layers. Pipe lengths will not be calculated."
msgstr "输入图层中未找到有效 CRS。将不会计算管道长度。"

#: gusnet/api.py
msgid ""
"Some input layers do not have a valid CRS. Pipe lengths may not be "
"calculated correctly."
msgstr "部分输入图层没有有效 CRS。管道长度可能无法被正确计算。"

#: gusnet/api.py
msgid "Multiple different CRSs found on input layers."
msgstr "在输入图层中发现多个不同的 CRS。"

#: gusnet/api.py
#, python-brace-format
msgid "CRS {crs} is not valid."
msgstr "CRS {crs} 无效。"

#: gusnet/api.py
#, python-brace-format
msgid "{exception} is not a known set of units. Possible units are: "
msgstr "{exception} 不是已知的单位集合。可选单位为："

#: gusnet/api.py
#, python-brace-format
msgid ""
"{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS',"
" 'TANKS', 'PIPES', 'VALVES', 'PUMPS'."
msgstr "{value_error}。仅接受以下图层类型：'JUNCTIONS'、'RESERVOIRS'、'TANKS'、'PIPES'、'VALVES'、'PUMPS'。"

#: gusnet/dependencies.py
msgid "Fetching EPANET"
msgstr "正在获取 EPANET"

#: gusnet/dependencies.py
msgid "Took too long to fetch and install."
msgstr "获取和安装耗时过长。"

#: gusnet/dependencies.py
msgid "Couldn't find Python"
msgstr "无法找到 Python"

#: gusnet/dependencies.py
#, python-brace-format
msgid "Couldn't fetch and install gusnet_epanet. {exception}"
msgstr "无法获取并安装 gusnet_epanet。{exception}"

#: gusnet/dependencies.py
#, python-brace-format
msgid ""
"Missing necessary python packages {missing_deps}. Please see help for how"
" to fix this"
msgstr "缺少必要的 Python 包 {missing_deps}。请查看帮助了解如何修复。"

#: gusnet/dependencies.py
msgid "Fetching gusnet_epanet is already in progress. Please wait and try again."
msgstr "正在获取 gusnet_epanet，请稍候后重试。"

