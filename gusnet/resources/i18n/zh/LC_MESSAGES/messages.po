msgid "Head loss curve (flow vs head loss) for general purpose valve"
msgstr "通用阀的水头损失曲线（流量-水头损失）"

#: gusnet/elements.py
msgid "Initial water quality concentration for water quality analysis"
msgstr "用于水质分析的初始水质浓度"

#: gusnet/elements.py
msgid "Fraction of tank volume for mixing model for two-compartment mixing model"
msgstr "双仓混合模型中的水池体积分配比例"

#: gusnet/elements.py
msgid "Tank mixing model type for water quality analysis"
msgstr "用于水质分析的水池混合模型类型"

#: gusnet/elements.py
msgid "Bulk reaction rate coefficient for water quality analysis"
msgstr "用于水质分析的体相反应速率系数"

#: gusnet/elements.py
msgid "Wall reaction rate coefficient for water quality analysis"
msgstr "用于水质分析的壁面反应速率系数"

#: gusnet/elements.py
msgid "Pump efficiency curve (flow vs efficiency) for energy use analysis"
msgstr "用于能耗分析的泵效率曲线（流量-效率）"

#: gusnet/elements.py
msgid "Time-varying pattern for energy price"
msgstr "能源价格的随时间变化模式"

#: gusnet/elements.py
msgid "Energy price per kW hour for energy use analysis"
msgstr "用于能耗分析的每千瓦时能源价格"

