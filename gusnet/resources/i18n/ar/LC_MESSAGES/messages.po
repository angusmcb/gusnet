#, python-brace-format
msgid "No units specified. Will use the value from wn: {units_friendly_name}"
msgstr "لم يتم تحديد وحدات. سيتم استخدام القيمة من wn: {units_friendly_name}"

msgid "Cannot set headloss formula when wn is set. Set the headloss in the wn.options.hydraulic.headloss instead"
msgstr "لا يمكن تعيين معادلة فاقد الضغط عندما تكون wn معينة. عيّن فاقد الضغط في wn.options.hydraulic.headloss."

msgid "headloss must be set if wn is not set: possible values are: H-W, D-W, C-M"
msgstr "يجب تعيين فقدان الرأس إذا لم يتم تعيين wn: القيم الممكنة هي: H-W، D-W، C-M"

msgid "No valid CRS found on input layers. Pipe lengths will not be calculated."
msgstr "لم يتم العثور على نظام CRS صالح في طبقات الإدخال. لن يتم حساب أطوال الأنابيب."

msgid "Some input layers do not have a valid CRS. Pipe lengths may not be calculated correctly."
msgstr "بعض طبقات الإدخال لا تحتوي على CRS صالح. قد لا يتم حساب أطوال الأنابيب بشكل صحيح."

msgid "Multiple different CRSs found on input layers."
msgstr "تم العثور على عدة أنظمة CRS مختلفة في طبقات الإدخال."

#, python-brace-format
msgid "CRS {crs} is not valid."
msgstr "CRS {crs} غير صالح."

#, python-brace-format
msgid "{exception} is not a known set of units. Possible units are: "
msgstr "{exception} is not a known set of units. Possible units are:"

#, python-brace-format
msgid "{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS', 'TANKS', 'PIPES', 'VALVES', 'PUMPS'."
msgstr "{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS', 'TANKS', 'PIPES', 'VALVES', 'PUMPS'."

msgid "Fetching EPANET"
msgstr "جارٍ تنزيل EPANET"

msgid "Took too long to fetch and install."
msgstr "استغرق وقتًا طويلاً لجلب وتثبيت."

msgid "Couldn't find Python"
msgstr "تعذر العثور على Python"

#, python-brace-format
msgid "Couldn't fetch and install gusnet_epanet. {exception}"
msgstr "تعذر جلب وتثبيت gusnet_epanet. {exception}"

#, python-brace-format
msgid "Missing necessary python packages {missing_deps}. Please see help for how to fix this"
msgstr "الحزم الضرورية المفقودة {missing_deps}. يرجى الاطلاع على المساعدة لمعرفة كيفية إصلاح ذلك"

msgid "Fetching gusnet_epanet is already in progress. Please wait and try again."
msgstr "تنزيل gusnet_epanet قيد التنفيذ بالفعل. يرجى الانتظار ثم المحاولة مرة أخرى."

