msgstr "فقدان الرأس متناسب مع طول الأنبوب"

msgid "Water velocity in link"
msgstr "سرعة المياه في الرابط"

msgid "Water quality concentration"
msgstr "تركيز جودة المياه"

msgid "Rate of water quality reaction"
msgstr "معدل تفاعل جودة المياه"

msgid "Flow units for the model"
msgstr "وحدات التدفق للنموذج"

msgid "Flow units will determine the units of other units used in the model as well.Selecting a metric-based unit set means everything will be metric, wheras selecting an imperial measure means everything will be imperial."
msgstr "ستحدد وحدات التدفق أيضاً وحدات القيم الأخرى المستخدمة في النموذج. اختيار نظام وحدات متري يعني أن كل شيء سيكون مترياً، بينما اختيار نظام إمبريالي يعني أن كل شيء سيكون إمبريالياً."

msgid "Formula to use for headloss calculations"
msgstr "الصيغة المستخدمة لحساب فاقد الضغط"

msgid "Duration of the simulation in hours (or 0 for single period)"
msgstr "مدة المحاكاة بالساعات (أو 0 لفترة واحدة)"

msgid "Global multiplier for all demands in the model"
msgstr "المعامل العام لجميع الطلبات في النموذج"

msgid "Default pattern to use for any pattern fields left blank"
msgstr "النمط الافتراضي المستخدم لأي حقول نمط تُترك فارغة"

msgid "Exponent for emitter calculations"
msgstr "الأس لحسابات الباعث"

msgid "Whether to model demands as fixed or pressure dependent"
msgstr "ما إذا كان سيتم نمذجة الطلبات كثابتة أو معتمدة على الضغط"

msgid "Minimum pressure for pressure dependent demand calculations"
msgstr "الضغط الأدنى لحسابات الطلب المعتمد على الضغط"

msgid "Required pressure for pressure dependent demand calculations"
msgstr "الضغط المطلوب لحسابات الطلب المعتمد على الضغط"

msgid "Exponent for pressure dependent demand calculations"
msgstr "الأس لحسابات الطلب المعتمد على الضغط"

msgid "Price of energy per kW hour for energy calculations"
msgstr "سعر الطاقة لكل كيلوواط ساعة لتحليل استخدام الطاقة"

msgid "Pattern of price multiplier to use for energy calculations"
msgstr "نمط مضاعف السعر المستخدم لحسابات الطاقة"

msgid "Global efficiency of pumps for energy calculations - as a percentage"
msgstr "الكفاءة العامة للمضخات لحسابات الطاقة كنسبة مئوية"

msgid "Demand charge for energy calculations"
msgstr "رسم الطلب لحسابات الطاقة"

msgid "Type of water quality analysis to do"
msgstr "نوع تحليل جودة المياه المطلوب"

msgid "Mass unit to use for water quality analysis"
msgstr "وحدة الكتلة المستخدمة لتحليل جودة المياه"

msgid "Relative diffusivity for water quality analysis"
msgstr "الانتشارية النسبية لتحليل جودة المياه"

msgid "Node to track for trace analysis (if quality parameter is TRACE)"
msgstr "العقدة المراد تتبعها لتحليل التتبع (إذا كانت معلمة الجودة TRACE)"

msgid "Tolerance for water quality convergence in extended period simulations"
msgstr "سماحية تقارب جودة المياه في محاكاة الفترات الممتدة"

msgid "Order of the bulk reaction for water quality analysis"
msgstr "رتبة التفاعل الحجمي لتحليل جودة المياه"

msgid "Order of the wall reaction for water quality analysis"
msgstr "رتبة تفاعل الجدار لتحليل جودة المياه"

msgid "Global bulk coefficient for water quality analysis"
msgstr "معامل التفاعل الحجمي العام لتحليل جودة المياه"

msgid "Global wall coefficient for water quality analysis"
msgstr "معامل التفاعل الجداري العام لتحليل جودة المياه"

msgid "Limiting concentration for water quality analysis (concentration below which reactions are assumed to stop)"
msgstr "التركيز الحدي لتحليل جودة المياه (التركيز الذي تُفترض دونه توقف التفاعلات)"

msgid "Correlation for calculating wall reaction coefficient based on pipe diameter (if 0, wall coefficient will be constant)"
msgstr "العلاقة المستخدمة لحساب معامل تفاعل الجدار استناداً إلى قطر الأنبوب (إذا كانت 0 فسيكون معامل الجدار ثابتاً)"

#, python-brace-format
msgid "EPANET returned warning code {error_code}: {warning_text}"
msgstr "أعاد EPANET رمز التحذير {error_code}: {warning_text}"

#, python-brace-format
msgid "EPANET returned warning code {error_code} at simulation time {time}: {warning_text}"
msgstr "أعاد EPANET رمز التحذير {error_code} عند زمن المحاكاة {time}: {warning_text}"

msgid "System hydraulically unbalanced - convergence to a hydraulic solution was not achieved in the allowed number of trials"
msgstr "System hydraulically unbalanced - convergence to a hydraulic solution was not achieved in the allowed number of trials"

msgid "System may be hydraulically unstable - hydraulic convergence was only achieved after the status of all links was held fixed"
msgstr "System may be hydraulically unstable - hydraulic convergence was only achieved after the status of all links was held fixed"

msgid "System disconnected - one or more nodes with positive demands were disconnected for all supply sources"
msgstr "System disconnected - one or more nodes with positive demands were disconnected for all supply sources"

msgid "Pumps cannot deliver enough flow or head - one or more pumps were forced to either shut down (due to insufficient head) or operate beyond the maximum rated flow"
msgstr "لا تستطيع المضخات توفير تدفق أو ارتفاع كافٍ - أُجبرت مضخة واحدة أو أكثر إما على التوقف (بسبب ارتفاع غير كافٍ) أو التشغيل فوق التدفق الاسمي الأقصى"

msgid "Valves cannot deliver enough flow - one or more flow control valves could not deliver the required flow even when fully open"
msgstr "لا تستطيع الصمامات توفير تدفق كافٍ - لم يتمكن صمام واحد أو أكثر للتحكم في التدفق من توفير التدفق المطلوب حتى عند الفتح الكامل"

msgid "System has negative pressures - negative pressures occurred at one or more junctions with positive demand"
msgstr "النظام يحتوي على ضغوط سالبة - حدثت ضغوط سالبة عند وصلة واحدة أو أكثر ذات طلب موجب"

msgid "insufficient memory available"
msgstr "الذاكرة المتاحة غير كافية"

msgid "no network data available"
msgstr "لا توجد بيانات شبكة متاحة"

msgid "hydraulics not initialized"
msgstr "لم يتم تهيئة الحسابات الهيدروليكية"

msgid "no hydraulics for water quality analysis"
msgstr "لا توجد بيانات هيدروليكية لتحليل جودة المياه"

msgid "water quality not initialized"
msgstr "لم يتم تهيئة جودة المياه"

msgid "no results saved to report on"
msgstr "لا توجد نتائج محفوظة لإعداد تقرير عنها"

msgid "hydraulics supplied from external file"
msgstr "تم توفير بيانات الهيدروليكا من ملف خارجي"

msgid "cannot use external file while hydraulics solver is active"
msgstr "لا يمكن استخدام ملف خارجي أثناء عمل محلل الهيدروليكا"

msgid "cannot change time parameter when solver is active"
msgstr "لا يمكن تغيير معلمة الوقت أثناء عمل المحلل"

msgid "cannot solve network hydraulic equations"
msgstr "تعذر حل معادلات الهيدروليكا للشبكة"

msgid "cannot solve water quality transport equations"
msgstr "تعذر حل معادلات نقل جودة المياه"

msgid "one or more errors in input file"
msgstr "يوجد خطأ واحد أو أكثر في ملف الإدخال"

msgid "syntax error"
msgstr "خطأ في البنية"

msgid "invalid section keyword"
msgstr "كلمة مفتاحية للقسم غير صالحة"

msgid "illegal numeric value"
msgstr "قيمة رقمية غير صالحة"

msgid "undefined node"
msgstr "عقدة غير معرّفة"

msgid "undefined link"
