msgstr "Impossibile scaricare e installare gusnet_epanet. {exception}"

#: gusnet/dependencies.py:145
#, python-brace-format
msgid ""
"Missing necessary python packages {missing_deps}. Please see help for how"
" to fix this"
msgstr ""
"Mancano i pacchetti python necessari {missing_deps}. Consulta la guida "
"per sapere come risolvere il problema"

#: gusnet/dependencies.py:153
msgid "Fetching gusnet_epanet is already in progress. Please wait and try again."
msgstr "Il recupero di gusnet_epanet e gia in corso. Attendi e riprova."

