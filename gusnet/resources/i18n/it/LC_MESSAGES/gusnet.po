#: gusnet/elements.py
msgid ""
"Element identifier. If provided, it must be less than 32 characters and "
"not contain any spaces."
msgstr ""
"Identificatore dell'elemento. Se fornito, deve avere meno di 32 caratteri"
" e non contenere spazi."

#: gusnet/elements.py
msgid "Height above datum. This is in metres or feet."
msgstr "Altezza sopra il datum. Espressa in metri o piedi."

#: gusnet/elements.py
msgid "The demand for the element. Can be negative for inflows."
msgstr "La domanda dell'elemento. Puo essere negativa per gli afflussi."

#: gusnet/elements.py
msgid "Time-varying multiplier pattern for base demand"
msgstr "Schema moltiplicatore variabile nel tempo per la domanda di base"

#: gusnet/elements.py
msgid "Coefficient for flow through emitter at junction"
msgstr "Coefficiente per il flusso attraverso l'emettitore al nodo"

#: gusnet/elements.py
msgid "Initial water level in tank"
msgstr "Livello iniziale dell'acqua nel serbatoio"

#: gusnet/elements.py
msgid "Minimum allowable water level in tank"
msgstr "Livello minimo consentito dell'acqua nel serbatoio"

#: gusnet/elements.py
msgid "Maximum allowable water level in tank"
msgstr "Livello massimo consentito dell'acqua nel serbatoio"

#: gusnet/elements.py
msgid "Type of valve (PRV, PSV, PBV, FCV, TCV, GPV)"
msgstr "Tipo di valvola (PRV, PSV, PBV, FCV, TCV, GPV)"

#: gusnet/elements.py
msgid "Pressure setting for PRV, PBV, and PSV"
msgstr "Impostazione di pressione per PRV, PBV e PSV"

#: gusnet/elements.py
msgid "Flow setting for FCV"
msgstr "Impostazione di portata per FCV"

#: gusnet/elements.py
msgid "Throttle setting for TCV"
msgstr "Impostazione di strozzamento per TCV"

#: gusnet/elements.py
msgid "Internal diameter of pipe"
msgstr "Diametro interno della tubazione"

#: gusnet/elements.py
msgid "Diameter of tank"
msgstr "Diametro del serbatoio"

#: gusnet/elements.py
msgid "Minimum volume of water in tank"
msgstr "Volume minimo di acqua nel serbatoio"

#: gusnet/elements.py
msgid "Volume curve relating tank level to volume"
msgstr "Curva di volume che collega il livello del serbatoio al volume"

#: gusnet/elements.py
msgid "Whether tank can overflow when full"
msgstr "Se il serbatoio puo tracimare quando e pieno"

#: gusnet/elements.py
msgid "Hydraulic head at reservoir"
msgstr "Carico idraulico al serbatoio"

#: gusnet/elements.py
msgid "Time-varying pattern for reservoir head"
msgstr "Schema variabile nel tempo per il carico del serbatoio"

#: gusnet/elements.py
msgid ""
"Physical length of pipe. If left blank this will be calculated "
"automatically"
msgstr ""
"Lunghezza fisica della tubazione. Se lasciata vuota, verra calcolata "
"automaticamente"

#: gusnet/elements.py
msgid "Pipe roughness coefficient for headloss calculation"
msgstr ""
"Coefficiente di rugosita della tubazione per il calcolo delle perdite di "
"carico"

#: gusnet/elements.py
msgid "Minor loss coefficient for fittings and bends"
msgstr "Coefficiente di perdita minore per raccordi e curve"

#: gusnet/elements.py
msgid "Whether pipe has check valve to prevent backflow"
msgstr "Se la tubazione ha una valvola di ritegno per prevenire il riflusso"

#: gusnet/elements.py
msgid "How is pump described (by power or by head curve)"
msgstr "Come e descritta la pompa (per potenza o per curva di prevalenza)"

#: gusnet/elements.py
msgid "Flow vs head curve for pump"
msgstr "Curva portata-prevalenza della pompa"

#: gusnet/elements.py
msgid "Power rating of pump"
msgstr "Potenza nominale della pompa"

#: gusnet/elements.py
msgid "Base rotational speed of pump"
msgstr "Velocita di rotazione base della pompa"

#: gusnet/elements.py
msgid "Time-varying pattern for pump speed"
msgstr "Schema variabile nel tempo per la velocita della pompa"

#: gusnet/elements.py
msgid "Initial operating status"
msgstr "Stato operativo iniziale"

#: gusnet/elements.py
msgid "Initial valve status (active, open, closed)"
msgstr "Stato iniziale della valvola (attiva, aperta, chiusa)"

#: gusnet/elements.py
msgid "Head loss curve (flow vs head loss) for general purpose valve"
msgstr ""
"Curva di perdita di carico (portata vs perdita) per valvola di uso "
"generale"

#: gusnet/elements.py
msgid "Initial water quality concentration for water quality analysis"
msgstr ""
"Concentrazione iniziale della qualita dell'acqua per l'analisi della "
"qualita"

#: gusnet/elements.py
msgid "Fraction of tank volume for mixing model for two-compartment mixing model"
msgstr ""
"Frazione del volume del serbatoio per il modello di miscelazione a due "
"compartimenti"

#: gusnet/elements.py
msgid "Tank mixing model type for water quality analysis"
msgstr ""
"Tipo di modello di miscelazione del serbatoio per l'analisi della qualita"
" dell'acqua"

#: gusnet/elements.py
msgid "Bulk reaction rate coefficient for water quality analysis"
msgstr ""
"Coefficiente di velocita di reazione in massa per l'analisi della qualita"
" dell'acqua"

#: gusnet/elements.py
msgid "Wall reaction rate coefficient for water quality analysis"
msgstr ""
"Coefficiente di velocita di reazione a parete per l'analisi della qualita"
" dell'acqua"

#: gusnet/elements.py
msgid "Pump efficiency curve (flow vs efficiency) for energy use analysis"
msgstr ""
"Curva di efficienza della pompa (portata vs efficienza) per l'analisi "
"energetica"

#: gusnet/elements.py
msgid "Time-varying pattern for energy price"
msgstr "Schema variabile nel tempo per il prezzo dell'energia"

#: gusnet/elements.py
msgid "Energy price per kW hour for energy use analysis"
msgstr "Prezzo dell'energia per kWh per l'analisi energetica"

#: gusnet/elements.py
msgid "Water demand at node"
msgstr "Domanda d'acqua al nodo"

#: gusnet/elements.py
msgid "Hydraulic head at node"
msgstr "Carico idraulico al nodo"

#: gusnet/elements.py
msgid "Water pressure at node"
msgstr "Pressione dell'acqua al nodo"

#: gusnet/elements.py
msgid "Water flow rate through link"
msgstr "Portata d'acqua attraverso il collegamento"

#: gusnet/elements.py
msgid "Head loss across link"
msgstr "Perdita di carico nel collegamento"

#: gusnet/elements.py
msgid "Head loss proportional to length of pipe"
msgstr "Perdita di carico proporzionale alla lunghezza della tubazione"

#: gusnet/elements.py
msgid "Water velocity in link"
msgstr "Velocita dell'acqua nel collegamento"

#: gusnet/elements.py
msgid "Water quality concentration"
msgstr "Concentrazione della qualita dell'acqua"

#: gusnet/elements.py
msgid "Rate of water quality reaction"
msgstr "Velocita di reazione della qualita dell'acqua"

#: gusnet/elements.py
msgid "Flow units for the model"
msgstr "Unità di portata per il modello"

#: gusnet/elements.py
msgid ""
"Flow units will determine the units of other units used in the model as "
"well.Selecting a metric-based unit set means everything will be metric, "
"wheras selecting an imperial measure means everything will be imperial."
msgstr ""
"Le unità di portata determinano anche le unità delle altre grandezze "
"usate nel modello. Se si seleziona un sistema metrico, tutto sarà "
"metrico; se si seleziona un sistema imperiale, tutto sarà imperiale."

#: gusnet/elements.py
msgid "Formula to use for headloss calculations"
msgstr "Formula da usare per i calcoli delle perdite di carico"

#: gusnet/elements.py
msgid "Duration of the simulation in hours (or 0 for single period)"
msgstr "Durata della simulazione in ore (o 0 per periodo singolo)"

#: gusnet/elements.py
msgid "Global multiplier for all demands in the model"
msgstr "Moltiplicatore globale per tutte le domande del modello"

#: gusnet/elements.py
msgid "Default pattern to use for any pattern fields left blank"
msgstr "Schema predefinito da usare per i campi schema lasciati vuoti"

#: gusnet/elements.py
msgid "Exponent for emitter calculations"
msgstr "Esponente per i calcoli degli emettitori"

#: gusnet/elements.py
msgid "Whether to model demands as fixed or pressure dependent"
msgstr "Se modellare le domande come fisse o dipendenti dalla pressione"

#: gusnet/elements.py
msgid "Minimum pressure for pressure dependent demand calculations"
msgstr "Pressione minima per i calcoli di domanda dipendente dalla pressione"

#: gusnet/elements.py
msgid "Required pressure for pressure dependent demand calculations"
msgstr "Pressione richiesta per i calcoli di domanda dipendente dalla pressione"

#: gusnet/elements.py
msgid "Exponent for pressure dependent demand calculations"
msgstr "Esponente per i calcoli di domanda dipendente dalla pressione"

#: gusnet/elements.py
msgid "Price of energy per kW hour for energy calculations"
msgstr "Prezzo dell'energia per kWh per l'analisi energetica"

#: gusnet/elements.py
msgid "Pattern of price multiplier to use for energy calculations"
msgstr "Schema del moltiplicatore di prezzo da usare per i calcoli energetici"

#: gusnet/elements.py
msgid "Global efficiency of pumps for energy calculations - as a percentage"
msgstr "Efficienza globale delle pompe per i calcoli energetici - in percentuale"

#: gusnet/elements.py
msgid "Demand charge for energy calculations"
msgstr "Costo di domanda per i calcoli energetici"

#: gusnet/elements.py
msgid "Type of water quality analysis to do"
msgstr "Tipo di analisi della qualità dell'acqua da eseguire"

#: gusnet/elements.py
msgid "Mass unit to use for water quality analysis"
msgstr "Unità di massa da usare per l'analisi della qualità dell'acqua"

#: gusnet/elements.py
msgid "Relative diffusivity for water quality analysis"
msgstr "Diffusività relativa per l'analisi della qualità dell'acqua"

#: gusnet/elements.py
msgid "Node to track for trace analysis (if quality parameter is TRACE)"
msgstr ""
"Nodo da tracciare per l'analisi del tracciante (se il parametro di "
"qualità è TRACE)"

#: gusnet/elements.py
msgid "Tolerance for water quality convergence in extended period simulations"
msgstr ""
"Tolleranza di convergenza della qualità dell'acqua nelle simulazioni a "
"periodo esteso"

#: gusnet/elements.py
msgid "Order of the bulk reaction for water quality analysis"
msgstr "Ordine della reazione in massa per l'analisi della qualità dell'acqua"

#: gusnet/elements.py
msgid "Order of the wall reaction for water quality analysis"
msgstr "Ordine della reazione di parete per l'analisi della qualità dell'acqua"

#: gusnet/elements.py
msgid "Global bulk coefficient for water quality analysis"
msgstr ""
"Coefficiente globale della reazione in massa per l'analisi della qualità "
"dell'acqua"

#: gusnet/elements.py
msgid "Global wall coefficient for water quality analysis"
msgstr ""
"Coefficiente globale della reazione di parete per l'analisi della qualità"
" dell'acqua"

#: gusnet/elements.py
msgid ""
"Limiting concentration for water quality analysis (concentration below "
"which reactions are assumed to stop)"
msgstr ""
"Concentrazione limite per l'analisi della qualità dell'acqua (al di sotto"
" di tale concentrazione si assume che le reazioni si arrestino)"

#: gusnet/elements.py
msgid ""
"Correlation for calculating wall reaction coefficient based on pipe "
"diameter (if 0, wall coefficient will be constant)"
msgstr ""
"Correlazione per calcolare il coefficiente di reazione di parete in base "
"al diametro della tubazione (se è 0, il coefficiente di parete sarà "
"costante)"

#: gusnet/epanet_wrapper.py
#, python-brace-format
msgid "EPANET returned warning code {error_code}: {warning_text}"
msgstr "EPANET ha restituito il codice di avviso {error_code}: {warning_text}"

#: gusnet/epanet_wrapper.py
#, python-brace-format
msgid ""
"EPANET returned warning code {error_code} at simulation time {time}: "
"{warning_text}"
msgstr ""
"EPANET ha restituito il codice di avviso {error_code} al tempo di "
"simulazione {time}: {warning_text}"

#: gusnet/epanet_wrapper.py
msgid ""
"System hydraulically unbalanced - convergence to a hydraulic solution was"
" not achieved in the allowed number of trials"
msgstr ""
"Sistema idraulicamente sbilanciato: non e stata raggiunta la convergenza "
"a una soluzione idraulica nel numero consentito di tentativi"

#: gusnet/epanet_wrapper.py
msgid ""
"System may be hydraulically unstable - hydraulic convergence was only "
"achieved after the status of all links was held fixed"
msgstr ""
"Il sistema potrebbe essere idraulicamente instabile: la convergenza "
"idraulica e stata raggiunta solo mantenendo fisso lo stato di tutti i "
"collegamenti"

#: gusnet/epanet_wrapper.py
msgid ""
"System disconnected - one or more nodes with positive demands were "
"disconnected for all supply sources"
msgstr ""
"Sistema disconnesso: uno o piu nodi con domanda positiva sono scollegati "
