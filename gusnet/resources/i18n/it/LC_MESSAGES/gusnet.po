#: gusnet/epanet_wrapper.py:171
msgid ""
"System hydraulically unbalanced - convergence to a hydraulic solution was"
" not achieved in the allowed number of trials"
msgstr ""
"Sistema idraulicamente sbilanciato: non e stata raggiunta la convergenza "
"a una soluzione idraulica nel numero consentito di tentativi"

#: gusnet/epanet_wrapper.py:174
msgid ""
"System may be hydraulically unstable - hydraulic convergence was only "
"achieved after the status of all links was held fixed"
msgstr ""
"Il sistema potrebbe essere idraulicamente instabile: la convergenza "
"idraulica e stata raggiunta solo mantenendo fisso lo stato di tutti i "
"collegamenti"

#: gusnet/epanet_wrapper.py:176
msgid ""
"System disconnected - one or more nodes with positive demands were "
"disconnected for all supply sources"
msgstr ""
"Sistema disconnesso: uno o piu nodi con domanda positiva sono scollegati "
"da tutte le sorgenti di alimentazione"

#: gusnet/epanet_wrapper.py:178
msgid ""
"Pumps cannot deliver enough flow or head - one or more pumps were forced "
"to either shut down (due to insufficient head) or operate beyond the "
"maximum rated flow"
msgstr ""
"Le pompe non possono fornire portata o prevalenza sufficienti: una o piu "
"pompe sono state costrette a fermarsi (per prevalenza insufficiente) o a "
"operare oltre la portata massima nominale"

#: gusnet/epanet_wrapper.py:181
msgid ""
"Valves cannot deliver enough flow - one or more flow control valves could"
" not deliver the required flow even when fully open"
msgstr ""
"Le valvole non possono fornire portata sufficiente: una o piu valvole di "
"controllo della portata non hanno fornito la portata richiesta anche se "
"completamente aperte"

#: gusnet/epanet_wrapper.py:184
msgid ""
"System has negative pressures - negative pressures occurred at one or "
"more junctions with positive demand"
msgstr ""
"Il sistema presenta pressioni negative: si sono verificate pressioni "
"negative in una o piu giunzioni con domanda positiva"

#: gusnet/epanet_wrapper.py:187
msgid "insufficient memory available"
msgstr "memoria disponibile insufficiente"

#: gusnet/epanet_wrapper.py:188
msgid "no network data available"
msgstr "nessun dato di rete disponibile"

#: gusnet/epanet_wrapper.py:189
msgid "hydraulics not initialized"
msgstr "idraulica non inizializzata"

#: gusnet/epanet_wrapper.py:190
msgid "no hydraulics for water quality analysis"
msgstr "nessun dato idraulico per l'analisi della qualita dell'acqua"

#: gusnet/epanet_wrapper.py:191
msgid "water quality not initialized"
msgstr "qualita dell'acqua non inizializzata"

#: gusnet/epanet_wrapper.py:192
msgid "no results saved to report on"
msgstr "nessun risultato salvato da riportare"

#: gusnet/epanet_wrapper.py:193
msgid "hydraulics supplied from external file"
msgstr "dati idraulici forniti da file esterno"

#: gusnet/epanet_wrapper.py:194
msgid "cannot use external file while hydraulics solver is active"
msgstr "impossibile usare un file esterno mentre il solutore idraulico e attivo"

#: gusnet/epanet_wrapper.py:195
msgid "cannot change time parameter when solver is active"
msgstr "impossibile modificare il parametro temporale quando il solutore e attivo"

#: gusnet/epanet_wrapper.py:196
