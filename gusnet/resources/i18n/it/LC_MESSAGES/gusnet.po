#: gusnet/api.py
#, python-brace-format
msgid "No units specified. Will use the value from wn: {units_friendly_name}"
msgstr ""
"Nessuna unita specificata. Verra usato il valore da wn: "
"{units_friendly_name}"

#: gusnet/api.py
msgid ""
"Cannot set headloss formula when wn is set. Set the headloss in the "
"wn.options.hydraulic.headloss instead"
msgstr ""
"Impossibile impostare la formula di perdita di carico quando wn e "
"impostato. Imposta invece la perdita di carico in "
"wn.options.hydraulic.headloss."

#: gusnet/api.py
msgid "headloss must be set if wn is not set: possible values are: H-W, D-W, C-M"
msgstr ""
"la perdita di altezza deve essere impostata se wn non è impostato: i "
"valori possibili sono: H-W, D-W, C-M"

#: gusnet/api.py
msgid "No valid CRS found on input layers. Pipe lengths will not be calculated."
msgstr ""
"Nessun CRS valido trovato nei layer di input. Le lunghezze delle "
"tubazioni non verranno calcolate."

#: gusnet/api.py
msgid ""
"Some input layers do not have a valid CRS. Pipe lengths may not be "
"calculated correctly."
msgstr ""
"Alcuni layer di input non hanno un CRS valido. Le lunghezze delle "
"tubazioni potrebbero non essere calcolate correttamente."

#: gusnet/api.py
msgid "Multiple different CRSs found on input layers."
msgstr "Sono stati trovati CRS diversi nei layer di input."

#: gusnet/api.py
#, python-brace-format
msgid "CRS {crs} is not valid."
msgstr "CRS {crs} non è valido."

#: gusnet/api.py
#, python-brace-format
msgid "{exception} is not a known set of units. Possible units are: "
msgstr "{exception} non e un insieme di unita noto. Le unita possibili sono:"

#: gusnet/api.py
#, python-brace-format
msgid ""
"{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS',"
" 'TANKS', 'PIPES', 'VALVES', 'PUMPS'."
msgstr ""
"{value_error}. I soli tipi di layer accettati sono 'JUNCTIONS', "
"'RESERVOIRS', 'TANKS', 'PIPES', 'VALVES', 'PUMPS'."

#: gusnet/dependencies.py
msgid "Fetching EPANET"
msgstr "Recupero di EPANET"

#: gusnet/dependencies.py
msgid "Took too long to fetch and install."
msgstr "Il download e l'installazione hanno impiegato troppo tempo."

#: gusnet/dependencies.py
msgid "Couldn't find Python"
msgstr "Impossibile trovare Python"

#: gusnet/dependencies.py
#, python-brace-format
msgid "Couldn't fetch and install gusnet_epanet. {exception}"
msgstr "Impossibile scaricare e installare gusnet_epanet. {exception}"

#: gusnet/dependencies.py
#, python-brace-format
msgid ""
"Missing necessary python packages {missing_deps}. Please see help for how"
" to fix this"
msgstr ""
"Mancano i pacchetti python necessari {missing_deps}. Consulta la guida "
"per sapere come risolvere il problema"

#: gusnet/dependencies.py
msgid "Fetching gusnet_epanet is already in progress. Please wait and try again."
msgstr "Il recupero di gusnet_epanet e gia in corso. Attendi e riprova."

